{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cafri-web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--urls", "http://localhost:5261"],
      "port": 5261
    },
    {
      "name": "cafri-web-release",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "-c", "Release", "--no-build", "--urls", "http://localhost:5262"],
      "port": 5262
    },
    {
      "name": "cafri-web-verify",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "-p:BaseOutputPath=bin-verify/", "--urls", "http://localhost:5263"],
      "port": 5263
    }
  ]
}
