@model CAFRI.Areas.Admin.ViewModels.Content.CountryIndexViewModel

<section class="admin-listing">
    <div class="admin-page__hero">
        <div class="admin-listing__header">
            <div>
                <div class="admin-eyebrow">Content Management</div>
                <h1 class="admin-page__title">Countries</h1>
                <p class="admin-page__lead">
                    Maintain country profiles, capitals, summary metrics and detail payloads used by the CAFRI country pages and interactive map.
                </p>
            </div>
            <a asp-area="Admin" asp-controller="Countries" asp-action="Create" class="admin-primary-button">Create Country</a>
        </div>
    </div>

    <div class="admin-summary-grid">
        @foreach (var card in Model.SummaryCards)
        {
            <article class="admin-summary-card">
                <div class="admin-summary-card__label">@card.Label</div>
                <div class="admin-summary-card__value">@card.Value</div>
                <div class="admin-summary-card__caption">@card.Caption</div>
            </article>
        }
    </div>

    <section class="admin-panel mt-3">
        <form method="get" class="admin-filters" style="grid-template-columns: minmax(16rem,1.6fr) minmax(0,1fr) auto;">
            <input type="search" name="search" value="@Model.Search" class="admin-filter-control" placeholder="Search countries..." />

            <select name="status" class="form-select admin-filter-control">
                <option value="">All Statuses</option>
                <option value="published" selected="@(Model.Status == "published" ? "selected" : null)">Published</option>
                <option value="draft" selected="@(Model.Status == "draft" ? "selected" : null)">Draft</option>
            </select>

            <div class="d-flex gap-2">
                <button type="submit" class="admin-primary-button">Apply</button>
                <a asp-area="Admin" asp-controller="Countries" asp-action="Index" class="admin-chip">Reset</a>
            </div>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="admin-empty-state">
                No country profiles found. Try adjusting your search or filters.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-data-table align-middle">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Capital</th>
                            <th>Status</th>
                            <th>Updated</th>
                            <th>Order</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Code</td>
                            <td>
                                <div class="fw-semibold">@item.Name</div>
                                <div class="text-secondary">@item.Slug</div>
                            </td>
                            <td>@item.Capital</td>
                            <td>
                                <span class="admin-status-pill @(item.IsPublished ? "is-live" : "is-draft")">
                                    @(item.IsPublished ? "Published" : "Draft")
                                </span>
                            </td>
                            <td>@item.UpdatedAtUtc.UtcDateTime.ToString("dd MMM yyyy")</td>
                            <td>@item.DisplayOrder</td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Countries" asp-action="Edit" asp-route-id="@item.Id" class="admin-inline-link">Edit</a>
                                <a asp-area="" asp-controller="Countries" asp-action="Details" asp-route-slug="@item.Slug" class="admin-inline-link" target="_blank" rel="noreferrer">Preview</a>
                                <form asp-area="Admin" asp-controller="Countries" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-2">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>
