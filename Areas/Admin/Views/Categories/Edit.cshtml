@model CAFRI.Areas.Admin.ViewModels.Content.ContentCategoryEditViewModel

<section class="admin-page">
    <div class="admin-page__hero">
        <div class="admin-eyebrow">Category Editor</div>
        <h1 class="admin-page__title">@((Model.Id is null) ? "Create Category" : "Edit Category")</h1>
        <p class="admin-page__lead">Control taxonomy labels and editorial grouping directly from the database-backed CMS layer.</p>
    </div>

    <div class="admin-editor">
        <section class="admin-editor-card">
            <form method="post" data-live-preview-form>
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" data-preview-target="Name" data-preview-key="title" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Slug" class="form-label"></label>
                        <input asp-for="Slug" class="form-control" data-preview-target="Slug" data-preview-key="slug" />
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Scope" class="form-label"></label>
                        <input asp-for="Scope" class="form-control" data-preview-target="Scope" data-preview-key="scope" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="DisplayOrder" class="form-label"></label>
                        <input asp-for="DisplayOrder" class="form-control" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="IsPublished" class="form-check-input" />
                            <label asp-for="IsPublished" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="6" data-preview-target="Description" data-preview-key="description"></textarea>
                    </div>
                </div>
                <div class="admin-editor-actions">
                    <button type="submit" class="admin-primary-button">Save Category</button>
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="admin-chip">Back to List</a>
                </div>
            </form>
        </section>
        <aside class="admin-editor-preview">
            <section class="admin-preview-card">
                <div class="admin-panel__eyebrow">Live Preview</div>
                <div class="admin-preview-card__badge-row">
                    <span class="admin-preview-card__badge" data-preview="scope" data-preview-fallback="Scope">@Model.Scope</span>
                </div>
                <h2 class="admin-preview-card__title" data-preview="title" data-preview-fallback="Category title">@Model.Name</h2>
                <p class="admin-preview-card__body" data-preview="description" data-preview-fallback="Category description preview.">@Model.Description</p>
                <ul class="admin-preview-list">
                    <li>Slug: <span data-preview="slug" data-preview-fallback="not-set">@Model.Slug</span></li>
                    <li>Storage: PostgreSQL `ContentCategories`</li>
                </ul>
            </section>
        </aside>
    </div>
</section>
