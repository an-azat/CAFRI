@model CAFRI.Areas.Admin.ViewModels.Dashboard.AdminDashboardViewModel

<section class="admin-page">
    <div class="admin-page__hero">
        <div>
            <div class="admin-eyebrow">Dashboard</div>
            <h1 class="admin-page__title">CAFRI Admin Panel</h1>
            <p class="admin-page__lead">
                Manage publications, intelligence items, country profiles, professional access and platform content from a single database-backed workspace.
            </p>
        </div>
    </div>

    <div class="admin-metric-grid">
        @foreach (var metric in Model.Metrics)
        {
            <article class="admin-metric-card admin-metric-card--@metric.Accent">
                <div class="admin-metric-card__label">@metric.Label</div>
                <div class="admin-metric-card__value">@metric.Value</div>
                <div class="admin-metric-card__change">@metric.ChangeLabel</div>
            </article>
        }
    </div>

    <div class="admin-dashboard-grid">
        <section class="admin-panel">
            <div class="admin-panel__header">
                <div>
                    <div class="admin-panel__eyebrow">Recent Content</div>
                    <h2 class="admin-panel__title">Latest updates across the platform</h2>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table admin-data-table align-middle">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Country</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Updated</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.RecentContent)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.ContentType</td>
                            <td>@item.CountryOrCoverage</td>
                            <td>@item.TopicOrCategory</td>
                            <td><span class="admin-status-pill @(item.Status == "Published" ? "is-live" : "is-draft")">@item.Status</span></td>
                            <td>@item.UpdatedLabel</td>
                            <td class="text-end">
                                @if (!string.IsNullOrWhiteSpace(item.EditUrl))
                                {
                                    <a href="@item.EditUrl" class="admin-inline-link">Edit</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.PreviewUrl))
                                {
                                    <a href="@item.PreviewUrl" class="admin-inline-link" target="_blank" rel="noreferrer">Preview</a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <aside class="admin-side-stack">
            <section class="admin-panel">
                <div class="admin-panel__eyebrow">Quick Actions</div>
                <h2 class="admin-panel__title">Editorial shortcuts</h2>
                <div class="admin-action-list">
                    <a asp-area="Admin" asp-controller="Publications" asp-action="Create" class="admin-action-card">Add Publication</a>
                    <a asp-area="Admin" asp-controller="Intelligence" asp-action="Create" class="admin-action-card">Add Intelligence</a>
                    <a asp-area="Admin" asp-controller="Countries" asp-action="Index" class="admin-action-card">Edit Country Data</a>
                    <a asp-area="Admin" asp-controller="Sources" asp-action="Create" class="admin-action-card">Add Source</a>
                    <a asp-area="Admin" asp-controller="Indicators" asp-action="Create" class="admin-action-card">Update Indicator</a>
                    <a asp-area="Admin" asp-controller="AccessRequests" asp-action="Index" class="admin-action-card">Review Access Queue</a>
                </div>
            </section>

            <section class="admin-panel">
                <div class="admin-panel__eyebrow">System Notes</div>
                <h2 class="admin-panel__title">Data source</h2>
                <p class="admin-note">
                    Publications, intelligence materials and countries are now managed from PostgreSQL. JSON remains only as seed/bootstrap content where needed.
                </p>
            </section>
        </aside>
    </div>
</section>
