@model CAFRI.Areas.Admin.ViewModels.Content.PublicationContentEditViewModel
@using System.Linq

@section Head {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" />
}

@{
    var savedGalleryItems = (Model.GalleryText ?? string.Empty)
        .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(line => line.Split('|').Select(part => part.Trim()).ToArray())
        .Where(parts => parts.Length != 0 && !string.IsNullOrWhiteSpace(parts[0]))
        .Select(parts => new
        {
            ImageUrl = parts[0],
            Alt = parts.Length > 1 ? parts[1] : string.Empty,
            Title = parts.Length > 2 ? parts[2] : string.Empty,
            Caption = parts.Length > 3 ? string.Join(" | ", parts.Skip(3)) : string.Empty
        })
        .ToList();
    var executiveSummaryEditorValue = string.IsNullOrWhiteSpace(Model.ExecutiveSummaryText)
        ? string.Empty
        : (Model.ExecutiveSummaryText.Contains('<') && Model.ExecutiveSummaryText.Contains('>')
            ? Model.ExecutiveSummaryText
            : string.Join(string.Empty,
                Model.ExecutiveSummaryText
                    .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Select(line => $"<p>{line}</p>")));
}

<section class="admin-page">
    <div class="admin-page__hero">
        <div class="admin-eyebrow">Publication Editor</div>
        <h1 class="admin-page__title">@((Model.Id is null) ? "Create Publication" : "Edit Publication")</h1>
        <p class="admin-page__lead">
            Build the publication from a single, simplified editorial workspace — the same database record and public detail page are still driving everything underneath.
        </p>
    </div>

    <div class="admin-editor admin-editor--single">
        <section class="admin-editor-card">
            @if (Model.Id is not null && !string.IsNullOrWhiteSpace(Model.Slug))
            {
                <div class="admin-editor-actions mb-4">
                    <a class="admin-primary-button" href="/publications/@Model.Slug" target="_blank" rel="noreferrer">Open Publication Page</a>
                </div>
            }

            <form method="post" enctype="multipart/form-data" data-live-preview-form>
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })

                @if (TempData["AdminError"] is string errorMessage)
                {
                    <div class="alert alert-danger mb-4">@errorMessage</div>
                }

                @if (TempData["AdminSuccess"] is string successMessage)
                {
                    <div class="alert alert-success mb-4">@successMessage</div>
                }

                <div class="admin-publication-form">
                <div class="admin-publication-layout">
                <div class="admin-publication-main">

                <section class="admin-publication-form__card">
                <div class="admin-form-segment__header">
                    <div class="admin-panel__eyebrow">Publication</div>
                    <h2 class="admin-form-segment__title">Basic Information</h2>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Title" class="form-label">Title<span class="admin-required-mark">*</span></label>
                        <input asp-for="Title" class="form-control" data-preview-target="Title" data-preview-key="title" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Short Description<span class="admin-required-mark">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="1-2 sentence summary shown on publication cards and listings." data-preview-target="Description" data-preview-key="description"></textarea>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Type" class="form-label">Publication Type<span class="admin-required-mark">*</span></label>
                        <select asp-for="Type" class="form-select" data-preview-target="Type" data-preview-key="type">
                            @foreach (var type in Model.AvailableTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Topic" class="form-label"></label>
                        <select asp-for="Topic" class="form-select">
                            @foreach (var topic in Model.AvailableTopics)
                            {
                                <option value="@topic">@topic</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CountryCode" class="form-label">Country<span class="admin-required-mark">*</span></label>
                        <select asp-for="CountryCode" class="form-select" data-preview-target="CountryCode" data-preview-key="countryCode">
                            @foreach (var country in Model.AvailableCountries)
                            {
                                <option value="@country.Code">@country.Code</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PublishedMonth" class="form-label"></label>
                        <input asp-for="PublishedMonth" type="month" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ReadingTime" class="form-label"></label>
                        <select asp-for="ReadingTime" class="form-select">
                            @foreach (var readingTime in Model.AvailableReadingTimes)
                            {
                                <option value="@readingTime">@readingTime</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AuthorLabel" class="form-label"></label>
                        <input asp-for="AuthorLabel" class="form-control" placeholder="e.g. CAFRI Research Team" />
                    </div>
                </div>

                <details class="admin-advanced">
                    <summary>Advanced settings</summary>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CountryLabel" class="form-label">Country Name<span class="admin-auto-badge">auto</span></label>
                            <input asp-for="CountryLabel" class="form-control" readonly data-preview-target="CountryLabel" data-preview-key="countryLabel" />
                            <small class="form-text">Filled in automatically from the Country selection above.</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Meta" class="form-label">Meta Summary<span class="admin-auto-badge">auto</span></label>
                            <input asp-for="Meta" class="form-control" readonly data-preview-target="Meta" data-preview-key="meta" />
                            <small class="form-text">Built automatically from Published Date/Month and Reading Time.</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PublishedDate" class="form-label">Published Date<span class="admin-auto-badge">auto</span></label>
                            <input asp-for="PublishedDate" class="form-control" readonly />
                            <small class="form-text">Derived from Published Month above.</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DocumentLabel" class="form-label"></label>
                            <input asp-for="DocumentLabel" class="form-control" placeholder="e.g. PDF available | 1.2 MB" />
                            <small class="form-text">Short badge shown next to the download button.</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HeroVisualClassName" class="form-label"></label>
                            <input asp-for="HeroVisualClassName" class="form-control" placeholder="e.g. publication-hero-media--trade-corridors" />
                            <small class="form-text">CSS class controlling the hero background pattern when no hero image is set.</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SourceName" class="form-label"></label>
                            <input asp-for="SourceName" class="form-control" placeholder="e.g. World Bank" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SourceUrl" class="form-label"></label>
                            <input asp-for="SourceUrl" class="form-control" placeholder="https://example.org/original-report" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SourceDomain" class="form-label">Source Domain<span class="admin-auto-badge">auto</span></label>
                            <input asp-for="SourceDomain" class="form-control" readonly />
                            <small class="form-text">Extracted automatically from Source URL.</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExternalId" class="form-label"></label>
                            <input asp-for="ExternalId" class="form-control" placeholder="Optional import/reference ID" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SourcePublishedAtUtc" class="form-label"></label>
                            <input asp-for="SourcePublishedAtUtc" class="form-control" placeholder="2026-06-17T00:00:00+00:00" />
                            <small class="form-text">ISO date/time when the original source was published. Leave blank if unknown.</small>
                        </div>
                    </div>
                </details>
                </section>

                <section class="admin-publication-form__card">
                    <div class="admin-form-segment__header">
                        <div class="admin-panel__eyebrow">Narrative</div>
                        <h2 class="admin-form-segment__title">Intelligence Summary</h2>
                    </div>
                    <input asp-for="ActionsText" type="hidden" />
                    <div class="admin-summary-block">
                        <label asp-for="ExecutiveSummaryText" class="form-label"></label>
                        <textarea asp-for="ExecutiveSummaryText" class="form-control d-none" rows="8" data-executive-summary-raw></textarea>
                        <div class="admin-richtext-editor" data-executive-summary-editor>
                            <div class="admin-richtext-editor__toolbar" data-executive-summary-toolbar>
                                <span class="ql-formats">
                                    <select class="ql-header">
                                        <option selected></option>
                                        <option value="2"></option>
                                        <option value="3"></option>
                                    </select>
                                </span>
                                <span class="ql-formats">
                                    <button type="button" class="ql-bold"></button>
                                    <button type="button" class="ql-italic"></button>
                                    <button type="button" class="ql-underline"></button>
                                </span>
                                <span class="ql-formats">
                                    <button type="button" class="ql-list" value="ordered"></button>
                                    <button type="button" class="ql-list" value="bullet"></button>
                                    <button type="button" class="ql-blockquote"></button>
                                </span>
                                <span class="ql-formats">
                                    <button type="button" class="ql-link"></button>
                                    <button type="button" class="ql-clean"></button>
                                </span>
                            </div>
                            <div class="admin-richtext-editor__surface" data-executive-summary-surface>@Html.Raw(executiveSummaryEditorValue)</div>
                        </div>
                        <div class="form-text">Rich text editor for the Executive Summary block on the publication detail page.</div>
                    </div>

                    <label asp-for="ExecutiveHighlightsText" class="form-label"></label>
                    <textarea asp-for="ExecutiveHighlightsText" class="form-control" rows="3"></textarea>
                    <div class="form-text">One highlight per line.</div>
                </section>

                <section class="admin-publication-form__card">
                    <div class="admin-form-segment__header">
                        <div class="admin-panel__eyebrow">Content</div>
                        <h2 class="admin-form-segment__title">Article Content</h2>
                        <p class="admin-help-text">Add the findings, sections, charts and table rows that make up the article body — use the buttons below to insert a block.</p>
                    </div>

                    <textarea asp-for="KeyFindingsText" class="form-control font-monospace d-none" rows="6" data-publication-findings-raw></textarea>
                    <textarea asp-for="SectionsText" class="form-control font-monospace d-none" rows="8" data-publication-sections-raw></textarea>
                    <textarea asp-for="ChartsText" class="form-control font-monospace d-none" rows="8" data-publication-charts-raw></textarea>
                    <textarea asp-for="TableRowsText" class="form-control font-monospace d-none" rows="8" data-publication-table-raw></textarea>

                    <div class="admin-block-toolbar">
                        <button type="button" class="admin-chip publication-findings-editor__add" data-publication-findings-add>◆ Add Key Finding</button>
                        <button type="button" class="admin-chip publication-sections-editor__add" data-publication-sections-add>H2 Add Section</button>
                        <button type="button" class="admin-chip publication-charts-editor__add" data-publication-charts-add>◫ Add Chart</button>
                        <button type="button" class="admin-chip publication-table-editor__add" data-publication-table-add>▤ Add Table Row</button>
                    </div>

                    <div class="publication-findings-editor" data-publication-findings-editor>
                        <div class="admin-block-group admin-block-group--findings">
                            <span class="admin-block-group__label">◆ Key Findings</span>
                            <div class="publication-findings-editor__list" data-publication-findings-list></div>
                        </div>
                    </div>

                    <div class="publication-sections-editor" data-publication-sections-editor>
                        <div class="admin-block-group admin-block-group--sections">
                            <span class="admin-block-group__label">H2 Sections</span>
                            <div class="publication-sections-editor__list" data-publication-sections-list></div>
                        </div>
                    </div>

                    <div class="publication-charts-editor" data-publication-charts-editor>
                        <div class="admin-block-group admin-block-group--charts">
                            <span class="admin-block-group__label">◫ Charts</span>
                            <div class="publication-charts-editor__list" data-publication-charts-list></div>
                        </div>
                    </div>

                    <div class="publication-table-editor" data-publication-table-editor>
                        <div class="admin-block-group admin-block-group--table">
                            <span class="admin-block-group__label">▤ Transit Data Table</span>
                            <div class="publication-table-editor__list" data-publication-table-list></div>
                        </div>
                    </div>
                </section>

                <section class="admin-publication-form__card">
                    <div class="admin-form-segment__header">
                        <div class="admin-panel__eyebrow">Media</div>
                        <h2 class="admin-form-segment__title">Cover Image &amp; Gallery</h2>
                    </div>

                    <div class="admin-media-hero-editor" data-media-hero-editor>
                        <div class="admin-media-hero-editor__preview">
                            <img data-media-hero-preview-image alt="Publication hero image" hidden />
                            <div class="admin-media-hero-editor__placeholder" data-media-hero-preview-placeholder>No hero image</div>
                            <div class="admin-media-hero-editor__label" data-media-hero-preview-label>No hero image uploaded yet</div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="HeroImageUrl" class="form-label"></label>
                                <input asp-for="HeroImageUrl" class="form-control" readonly data-media-hero-url />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="HeroImageFile" class="form-label">Hero Photo Upload</label>
                                <input asp-for="HeroImageFile" type="file" class="form-control" accept="image/*" data-media-hero-file />
                                <span asp-validation-for="HeroImageFile" class="field-validation-error"></span>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.HeroImageUrl))
                    {
                        <section class="admin-saved-media admin-saved-media--compact">
                            <div class="admin-panel__eyebrow">Currently Saved</div>
                            <div class="admin-saved-media__section">
                                <h3>Saved Hero Image</h3>
                                <div class="admin-saved-media__hero">
                                    <img src="@Model.HeroImageUrl" alt="Saved publication hero image" />
                                    <div class="admin-saved-media__url">@Model.HeroImageUrl</div>
                                </div>
                            </div>
                        </section>
                    }

                    <details class="admin-advanced">
                        <summary>Photo Gallery (optional)</summary>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="GalleryFiles" class="form-label">Photo Gallery Uploads</label>
                                <input asp-for="GalleryFiles" type="file" class="form-control" multiple accept="image/*" />
                                <span asp-validation-for="GalleryFiles" class="field-validation-error"></span>
                                <div class="form-text">Upload one or more photos for the publication gallery.</div>
                            </div>
                            <div class="col-12">
                                <label asp-for="GalleryText" class="form-label">Photo Gallery Items</label>
                                <div class="admin-media-gallery-editor" data-media-gallery-editor>
                                    <textarea asp-for="GalleryText" class="form-control font-monospace d-none" rows="6" data-media-gallery-raw></textarea>
                                    <div class="admin-media-gallery-editor__list" data-media-gallery-list></div>
                                    <button type="button" class="admin-chip admin-media-gallery-editor__add" data-media-gallery-add>Add Gallery Item</button>
                                </div>
                                <div class="form-text">Manage gallery items visually. Data is still stored in the compatible `ImageUrl | Alt | Title | Caption` format.</div>
                            </div>
                        </div>
                        @if (savedGalleryItems.Count != 0)
                        {
                            <section class="admin-saved-media admin-saved-media--compact">
                                <div class="admin-panel__eyebrow">Currently Saved</div>
                                <div class="admin-saved-media__section">
                                    <h3>Saved Gallery</h3>
                                    <div class="admin-saved-media__gallery">
                                        @foreach (var item in savedGalleryItems)
                                        {
                                            <article class="admin-saved-media__gallery-item">
                                                <img src="@item.ImageUrl" alt="@(string.IsNullOrWhiteSpace(item.Alt) ? item.Title : item.Alt)" />
                                                <div class="admin-saved-media__gallery-copy">
                                                    <strong>@(string.IsNullOrWhiteSpace(item.Title) ? "Untitled image" : item.Title)</strong>
                                                    @if (!string.IsNullOrWhiteSpace(item.Caption))
                                                    {
                                                        <p>@item.Caption</p>
                                                    }
                                                    <span>@item.ImageUrl</span>
                                                </div>
                                            </article>
                                        }
                                    </div>
                                </div>
                            </section>
                        }
                    </details>
                </section>

                <section class="admin-publication-form__card">
                    <div class="admin-form-segment__header">
                        <div class="admin-panel__eyebrow">Resources</div>
                        <h2 class="admin-form-segment__title">Documents &amp; Resources</h2>
                    </div>

                    <label asp-for="DocumentsText" class="form-label"></label>
                    <textarea asp-for="DocumentsText" class="form-control font-monospace d-none" rows="5" data-publication-documents-raw></textarea>
                    <input asp-for="DocumentUploadMapText" type="hidden" data-publication-document-upload-map-raw />
                    <div class="publication-documents-editor" data-publication-documents-editor>
                        <div class="publication-documents-editor__list" data-publication-documents-list></div>
                        <button type="button" class="admin-chip publication-documents-editor__add" data-publication-documents-add>Add Document</button>
                    </div>
                    <div class="form-text">Manage publication documents as structured items. They will be saved into the compatible `Title | Type | Meta | DownloadUrl` format automatically.</div>

                    <label asp-for="DocumentFiles" class="form-label mt-3">Attached File Buffer</label>
                    <input asp-for="DocumentFiles" type="file" class="form-control d-none" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.csv,.txt" data-document-upload-input />
                    <span asp-validation-for="DocumentFiles" class="field-validation-error"></span>
                    <div class="form-text">Each document row above can choose its own file. Use `Choose File` to attach a new document, `Replace File` to swap it, or `Clear Pending File` before saving.</div>

                    <details class="admin-advanced">
                        <summary>Additional metadata</summary>

                        <label asp-for="RelatedIntelligenceText" class="form-label">Related Intelligence Links</label>
                        <textarea asp-for="RelatedIntelligenceText" class="form-control font-monospace d-none" rows="5" data-publication-related-raw></textarea>
                        <div class="publication-related-editor" data-publication-related-editor>
                            <div class="publication-related-editor__list" data-publication-related-list></div>
                            <button type="button" class="admin-chip publication-related-editor__add" data-publication-related-add>Add Related Item</button>
                        </div>
                        <div class="form-text mb-3">Manage related intelligence items as structured entries. They will be saved into the compatible `Title | Meta | Url` format automatically.</div>

                        <label asp-for="PublicationInfoText" class="form-label">Publication Info Rows</label>
                        <textarea asp-for="PublicationInfoText" class="form-control font-monospace d-none" rows="5" data-publication-info-raw></textarea>
                        <div class="publication-info-editor" data-publication-info-editor>
                            <div class="publication-info-editor__list" data-publication-info-list></div>
                            <button type="button" class="admin-chip publication-info-editor__add" data-publication-info-add>Add Info Row</button>
                        </div>
                        <div class="form-text">Manage publication info as structured label/value pairs. They will be saved into the compatible `Label | Value` format automatically.</div>
                    </details>
                </section>

                </div>

                <aside class="admin-publication-aside">
                    <section class="admin-preview-card">
                        <div class="admin-panel__eyebrow">Live Preview</div>
                        <div class="admin-preview-card__badge-row">
                            <span class="admin-preview-card__badge" data-preview="type" data-preview-fallback="Type">Type</span>
                        </div>
                        <h3 class="admin-preview-card__title" data-preview="title" data-preview-fallback="Untitled publication">Untitled publication</h3>
                        <p class="admin-preview-card__body" data-preview="description" data-preview-fallback="No description yet.">No description yet.</p>
                    </section>

                    <section class="admin-publication-form__card">
                        <div class="admin-form-segment__header">
                            <div class="admin-panel__eyebrow">Taxonomy</div>
                            <h2 class="admin-form-segment__title">Countries &amp; Categories</h2>
                        </div>
                        <label asp-for="AssignedCountriesText" class="form-label">Assigned Countries</label>
                        <textarea asp-for="AssignedCountriesText" class="form-control" rows="3"></textarea>
                        <div class="form-text mb-3">One country per line or comma-separated. Supports country codes, names and `Regional`.</div>

                        <label asp-for="AssignedCategoriesText" class="form-label">Assigned Categories</label>
                        <textarea asp-for="AssignedCategoriesText" class="form-control" rows="3"></textarea>
                        <div class="form-text">One category per line or comma-separated. Values are matched against CAFRI content categories.</div>
                    </section>

                    <section class="admin-publication-form__card">
                        <div class="admin-form-segment__header">
                            <div class="admin-panel__eyebrow">Workflow</div>
                            <h2 class="admin-form-segment__title">Publishing</h2>
                        </div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Slug" class="form-label">Slug<span class="admin-required-mark">*</span></label>
                                <input asp-for="Slug" class="form-control" placeholder="e.g. kazakhstan-banking-review-2026" data-preview-target="Slug" data-preview-key="slug" />
                                <small class="form-text">Used in the public URL. Lowercase, hyphen-separated, must be unique.</small>
                            </div>
                            <div class="col-12">
                                <label asp-for="WorkflowStatus" class="form-label">Status<span class="admin-required-mark">*</span></label>
                                <select asp-for="WorkflowStatus" class="form-select">
                                    @foreach (var status in Model.AvailableStatuses)
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </select>
                                <small class="form-text">Only "Published" is visible on the public site.</small>
                            </div>
                            <div class="col-12">
                                <label asp-for="DisplayOrder" class="form-label"></label>
                                <input asp-for="DisplayOrder" class="form-control" />
                                <small class="form-text">Lower numbers appear first in listings.</small>
                            </div>
                            <div class="col-6">
                                <div class="form-check">
                                    <input asp-for="IsPublished" class="form-check-input" />
                                    <label asp-for="IsPublished" class="form-check-label"></label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check">
                                    <input asp-for="RequiresReview" class="form-check-input" />
                                    <label asp-for="RequiresReview" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>
                    </section>
                </aside>
                </div>

                <details class="admin-advanced admin-advanced--full">
                    <summary>Advanced / Legacy compatibility</summary>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="PdfDownloadUrl" class="form-label">Legacy Download Link</label>
                            <input asp-for="PdfDownloadUrl" class="form-control" />
                            <small class="form-text">Optional compatibility field for older publication templates.</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DetailsJson" class="form-label">Legacy JSON Fallback</label>
                            <textarea asp-for="DetailsJson" class="form-control font-monospace" rows="6"></textarea>
                            <small class="form-text">Existing advanced blocks are preserved, but primary editing should now happen through the structured fields above.</small>
                        </div>
                    </div>
                </details>
                </div>

                <div class="admin-editor-actions">
                    <button type="submit" class="admin-primary-button">Save Publication</button>
                    <a asp-area="Admin" asp-controller="Publications" asp-action="Index" class="admin-chip">Back to List</a>
                </div>
            </form>
        </section>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script src="~/js/admin-media-editors.js" asp-append-version="true"></script>
    <script>
        (() => {
            const escapeValue = (value) =>
                String(value ?? "")
                    .replace(/&/g, "&amp;")
                    .replace(/"/g, "&quot;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;");

            const countryCode = document.getElementById("CountryCode");
            const countryLabel = document.getElementById("CountryLabel");
            const publishedMonth = document.getElementById("PublishedMonth");
            const publishedDate = document.getElementById("PublishedDate");
            const readingTime = document.getElementById("ReadingTime");
            const meta = document.getElementById("Meta");
            const documentsRaw = document.querySelector("[data-publication-documents-raw]");
            const documentUploadMapRaw = document.querySelector("[data-publication-document-upload-map-raw]");
            const documentsEditor = document.querySelector("[data-publication-documents-editor]");
            const documentsList = document.querySelector("[data-publication-documents-list]");
            const addDocumentButton = document.querySelector("[data-publication-documents-add]");
            const documentUploadInput = document.querySelector("[data-document-upload-input]");
            const relatedRaw = document.querySelector("[data-publication-related-raw]");
            const relatedEditor = document.querySelector("[data-publication-related-editor]");
            const relatedList = document.querySelector("[data-publication-related-list]");
            const addRelatedButton = document.querySelector("[data-publication-related-add]");
            const infoRaw = document.querySelector("[data-publication-info-raw]");
            const infoEditor = document.querySelector("[data-publication-info-editor]");
            const infoList = document.querySelector("[data-publication-info-list]");
            const addInfoButton = document.querySelector("[data-publication-info-add]");
            const findingsRaw = document.querySelector("[data-publication-findings-raw]");
            const findingsEditor = document.querySelector("[data-publication-findings-editor]");
            const findingsList = document.querySelector("[data-publication-findings-list]");
            const addFindingsButton = document.querySelector("[data-publication-findings-add]");
            const sectionsRaw = document.querySelector("[data-publication-sections-raw]");
            const sectionsEditor = document.querySelector("[data-publication-sections-editor]");
            const sectionsList = document.querySelector("[data-publication-sections-list]");
            const addSectionsButton = document.querySelector("[data-publication-sections-add]");
            const chartsRaw = document.querySelector("[data-publication-charts-raw]");
            const chartsEditor = document.querySelector("[data-publication-charts-editor]");
            const chartsList = document.querySelector("[data-publication-charts-list]");
            const addChartsButton = document.querySelector("[data-publication-charts-add]");
            const tableRaw = document.querySelector("[data-publication-table-raw]");
            const tableEditor = document.querySelector("[data-publication-table-editor]");
            const tableList = document.querySelector("[data-publication-table-list]");
            const addTableButton = document.querySelector("[data-publication-table-add]");
            if (!countryCode || !countryLabel) {
                return;
            }

            const labels = {
                @for (var i = 0; i < Model.AvailableCountries.Count; i++)
                {
                    var item = Model.AvailableCountries[i];
                    @:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Code)): @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Label))@(i < Model.AvailableCountries.Count - 1 ? "," : "")
                }
            };

            const syncCountryLabel = () => {
                countryLabel.value = labels[countryCode.value] || countryLabel.value;
            };

            const syncMeta = () => {
                if (!publishedMonth || !publishedDate || !readingTime || !meta) {
                    return;
                }

                if (publishedMonth.value) {
                    const [year, month] = publishedMonth.value.split("-");
                    const date = new Date(Number(year), Number(month) - 1, 1);
                    publishedDate.value = date.toLocaleString("en-US", { month: "long", year: "numeric" });
                }

                meta.value = `${publishedDate.value || "TBD"} | ${readingTime.value || "12 min read"}`;
            };

            const parseDocumentRows = (raw) => {
                if (!raw || !raw.trim()) {
                    return [];
                }

                return raw
                    .split(/\r?\n/)
                    .map((line) => line.trim())
                    .filter(Boolean)
                    .map((line) => {
                        const parts = line.split("|").map((part) => part.trim());
                        return {
                            title: parts[0] || "",
                            type: parts[1] || "",
                            meta: parts[2] || "",
                            url: parts.slice(3).join(" | ") || "#"
                        };
                    });
            };

            const buildDocumentMetaFromFile = (file) => {
                const extension = file.name.includes(".")
                    ? file.name.split(".").pop().toUpperCase()
                    : "FILE";
                const sizeLabel = file.size >= 1024 * 1024
                    ? `${(file.size / (1024 * 1024)).toFixed(1)} MB`
                    : file.size >= 1024
                        ? `${Math.round(file.size / 1024)} KB`
                        : `${file.size} B`;

                return {
                    type: extension,
                    meta: `${extension} | ${sizeLabel}`
                };
            };

            const pendingDocumentFiles = new Map();
            let documentRowSeed = 0;

            const syncPendingDocumentFiles = () => {
                if (!documentsList || !documentUploadInput || !documentUploadMapRaw) {
                    return;
                }

                const dataTransfer = new DataTransfer();
                const mappedRowIndexes = [];
                Array.from(documentsList.querySelectorAll("[data-document-row]")).forEach((row, index) => {
                    const rowId = row.getAttribute("data-document-row-id");
                    if (!rowId) {
                        return;
                    }

                    const pendingFile = pendingDocumentFiles.get(rowId);
                    if (!pendingFile) {
                        return;
                    }

                    dataTransfer.items.add(pendingFile);
                    mappedRowIndexes.push(String(index));
                });

                documentUploadInput.files = dataTransfer.files;
                documentUploadMapRaw.value = mappedRowIndexes.join("\n");
            };

            const updateDocumentFileUi = (row) => {
                const rowId = row.getAttribute("data-document-row-id");
                const pendingFile = rowId ? pendingDocumentFiles.get(rowId) : null;
                const fileName = row.querySelector("[data-document-file-name]");
                const fileMeta = row.querySelector("[data-document-file-meta]");
                const chooseButton = row.querySelector("[data-document-file-choose]");
                const clearButton = row.querySelector("[data-document-file-clear]");

                if (!(fileName instanceof HTMLElement) || !(fileMeta instanceof HTMLElement) || !(chooseButton instanceof HTMLElement) || !(clearButton instanceof HTMLElement)) {
                    return;
                }

                if (pendingFile) {
                    const generatedMeta = buildDocumentMetaFromFile(pendingFile);
                    row.setAttribute("data-document-type", generatedMeta.type);
                    row.setAttribute("data-document-meta", generatedMeta.meta);
                    row.setAttribute("data-document-url", "#");
                    fileName.textContent = pendingFile.name;
                    fileMeta.textContent = `${generatedMeta.type} • ${generatedMeta.meta}`;
                    chooseButton.textContent = "Replace File";
                    clearButton.hidden = false;
                }
                else
                {
                    const existingUrl = row.getAttribute("data-document-url") || "#";
                    const existingType = row.getAttribute("data-document-type") || "No file";
                    const existingMeta = row.getAttribute("data-document-meta") || "No metadata";
                    fileName.textContent = existingUrl && existingUrl !== "#" ? "Current file linked" : "No file selected";
                    fileMeta.textContent = `${existingType} • ${existingMeta}`;
                    chooseButton.textContent = "Choose File";
                    clearButton.hidden = true;
                }
            };

            const serializeDocumentRows = () => {
                if (!documentsRaw || !documentsList) {
                    return;
                }

                const rows = Array.from(documentsList.querySelectorAll("[data-document-row]"))
                    .map((row) => {
                        const title = row.querySelector("[data-document-field='title']")?.value?.trim() || "";
                        const type = row.getAttribute("data-document-type") || "";
                        const itemMeta = row.getAttribute("data-document-meta") || "";
                        const url = row.getAttribute("data-document-url") || "#";
                        if (!title && !type && !itemMeta && !url) {
                            return null;
                        }

                        return `${title} | ${type} | ${itemMeta} | ${url}`;
                    })
                    .filter(Boolean);

                documentsRaw.value = rows.join("\n");
                syncPendingDocumentFiles();
            };

            const buildDocumentRow = (item = {}) => {
                const row = document.createElement("div");
                row.className = "publication-document-row";
                row.setAttribute("data-document-row", "");
                row.setAttribute("data-document-row-id", `document-row-${documentRowSeed++}`);
                row.setAttribute("data-document-type", item.type || "");
                row.setAttribute("data-document-meta", item.meta || "");
                row.setAttribute("data-document-url", item.url || "#");
                row.innerHTML = `
                    <div class="publication-document-row__grid">
                        <div>
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" data-document-field="title" value="${escapeValue(item.title)}">
                        </div>
                        <div class="publication-document-row__full">
                            <label class="form-label">Attached File</label>
                            <div class="publication-document-row__file">
                                <div class="publication-document-row__file-copy">
                                    <span class="publication-document-row__file-name" data-document-file-name>No new file selected</span>
                                    <span class="publication-document-row__file-meta" data-document-file-meta>No metadata</span>
                                </div>
                                <div class="publication-document-row__file-actions">
                                    <button type="button" class="admin-chip" data-document-file-choose>Choose File</button>
                                    <button type="button" class="admin-chip admin-chip--ghost" data-document-file-clear hidden>Clear Pending File</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="publication-document-row__actions">
                        <button type="button" class="btn btn-sm btn-outline-danger" data-document-remove>Remove</button>
                    </div>
                `;

                row.querySelectorAll("input").forEach((input) => {
                    input.addEventListener("input", serializeDocumentRows);
                });

                row.querySelector("[data-document-file-choose]")?.addEventListener("click", () => {
                    const picker = document.createElement("input");
                    picker.type = "file";
                    picker.accept = ".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.csv,.txt";
                    picker.addEventListener("change", () => {
                        const selectedFile = picker.files?.[0];
                        const rowId = row.getAttribute("data-document-row-id");
                        if (!selectedFile || !rowId) {
                            return;
                        }

                        pendingDocumentFiles.set(rowId, selectedFile);
                        const titleInput = row.querySelector("[data-document-field='title']");
                        if (titleInput instanceof HTMLInputElement && !titleInput.value.trim()) {
                            titleInput.value = selectedFile.name.replace(/\.[^.]+$/, "").replace(/[_-]+/g, " ").trim();
                        }
                        updateDocumentFileUi(row);
                        serializeDocumentRows();
                    });

                    picker.click();
                });

                row.querySelector("[data-document-file-clear]")?.addEventListener("click", () => {
                    const rowId = row.getAttribute("data-document-row-id");
                    if (!rowId) {
                        return;
                    }

                    pendingDocumentFiles.delete(rowId);
                    updateDocumentFileUi(row);
                    serializeDocumentRows();
                });

                row.querySelector("[data-document-remove]")?.addEventListener("click", () => {
                    const rowId = row.getAttribute("data-document-row-id");
                    if (rowId) {
                        pendingDocumentFiles.delete(rowId);
                    }

                    row.remove();
                    serializeDocumentRows();
                });

                updateDocumentFileUi(row);
                return row;
            };

            const initDocumentsEditor = () => {
                if (!documentsRaw || !documentsEditor || !documentsList || !addDocumentButton) {
                    return;
                }

                const initialRows = parseDocumentRows(documentsRaw.value);
                if (initialRows.length === 0) {
                    documentsList.appendChild(buildDocumentRow({}));
                } else {
                    initialRows.forEach((item) => documentsList.appendChild(buildDocumentRow(item)));
                }

                addDocumentButton.addEventListener("click", () => {
                    documentsList.appendChild(buildDocumentRow({}));
                    serializeDocumentRows();
                });

                documentsRaw.form?.addEventListener("submit", serializeDocumentRows);
                serializeDocumentRows();
            };

            const parseRelatedRows = (raw) => {
                if (!raw || !raw.trim()) {
                    return [];
                }

                return raw
                    .split(/\r?\n/)
                    .map((line) => line.trim())
                    .filter(Boolean)
                    .map((line) => {
                        const parts = line.split("|").map((part) => part.trim());
                        return {
                            title: parts[0] || "",
                            meta: parts[1] || "",
                            url: parts.slice(2).join(" | ") || "#"
                        };
                    });
            };

            const serializeRelatedRows = () => {
                if (!relatedRaw || !relatedList) {
                    return;
                }

                const rows = Array.from(relatedList.querySelectorAll("[data-related-row]"))
                    .map((row) => {
                        const title = row.querySelector("[data-related-field='title']")?.value?.trim() || "";
                        const itemMeta = row.querySelector("[data-related-field='meta']")?.value?.trim() || "";
                        const url = row.querySelector("[data-related-field='url']")?.value?.trim() || "#";
                        if (!title && !itemMeta && !url) {
                            return null;
                        }

                        return `${title} | ${itemMeta} | ${url}`;
                    })
                    .filter(Boolean);

                relatedRaw.value = rows.join("\n");
            };

            const buildRelatedRow = (item = {}) => {
                const row = document.createElement("div");
                row.className = "publication-related-row";
                row.setAttribute("data-related-row", "");
                row.innerHTML = `
                    <div class="publication-related-row__grid">
                        <div>
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" data-related-field="title" value="${escapeValue(item.title)}">
                        </div>
                        <div>
                            <label class="form-label">Meta</label>
                            <input type="text" class="form-control" data-related-field="meta" value="${escapeValue(item.meta)}">
                        </div>
                        <div>
                            <label class="form-label">URL</label>
                            <input type="text" class="form-control" data-related-field="url" value="${escapeValue(item.url || "#")}">
                        </div>
                    </div>
                    <div class="publication-related-row__actions">
                        <button type="button" class="btn btn-sm btn-outline-danger" data-related-remove>Remove</button>
                    </div>
                `;

                row.querySelectorAll("input").forEach((input) => {
                    input.addEventListener("input", serializeRelatedRows);
                });

                row.querySelector("[data-related-remove]")?.addEventListener("click", () => {
                    row.remove();
                    serializeRelatedRows();
                });

                return row;
            };

            const initRelatedEditor = () => {
                if (!relatedRaw || !relatedEditor || !relatedList || !addRelatedButton) {
                    return;
                }

                const initialRows = parseRelatedRows(relatedRaw.value);
                if (initialRows.length === 0) {
                    relatedList.appendChild(buildRelatedRow({}));
                } else {
                    initialRows.forEach((item) => relatedList.appendChild(buildRelatedRow(item)));
                }

                addRelatedButton.addEventListener("click", () => {
                    relatedList.appendChild(buildRelatedRow({}));
                    serializeRelatedRows();
                });

                relatedRaw.form?.addEventListener("submit", serializeRelatedRows);
                serializeRelatedRows();
            };

            const parseInfoRows = (raw) => {
                if (!raw || !raw.trim()) {
                    return [];
                }

                return raw
                    .split(/\r?\n/)
                    .map((line) => line.trim())
                    .filter(Boolean)
                    .map((line) => {
                        const parts = line.split("|").map((part) => part.trim());
                        return {
                            label: parts[0] || "",
                            value: parts.slice(1).join(" | ") || ""
                        };
                    });
            };

            const serializeInfoRows = () => {
                if (!infoRaw || !infoList) {
                    return;
                }

                const rows = Array.from(infoList.querySelectorAll("[data-info-row]"))
                    .map((row) => {
                        const label = row.querySelector("[data-info-field='label']")?.value?.trim() || "";
                        const value = row.querySelector("[data-info-field='value']")?.value?.trim() || "";
                        if (!label && !value) {
                            return null;
                        }

                        return `${label} | ${value}`;
                    })
                    .filter(Boolean);

                infoRaw.value = rows.join("\n");
            };

            const buildInfoRow = (item = {}) => {
                const row = document.createElement("div");
                row.className = "publication-info-row";
                row.setAttribute("data-info-row", "");
                row.innerHTML = `
                    <div class="publication-info-row__grid">
                        <div>
                            <label class="form-label">Label</label>
                            <input type="text" class="form-control" data-info-field="label" value="${escapeValue(item.label)}">
                        </div>
                        <div>
                            <label class="form-label">Value</label>
                            <input type="text" class="form-control" data-info-field="value" value="${escapeValue(item.value)}">
                        </div>
                    </div>
                    <div class="publication-info-row__actions">
                        <button type="button" class="btn btn-sm btn-outline-danger" data-info-remove>Remove</button>
                    </div>
                `;

                row.querySelectorAll("input").forEach((input) => {
                    input.addEventListener("input", serializeInfoRows);
                });

                row.querySelector("[data-info-remove]")?.addEventListener("click", () => {
                    row.remove();
                    serializeInfoRows();
                });

                return row;
            };

            const initInfoEditor = () => {
                if (!infoRaw || !infoEditor || !infoList || !addInfoButton) {
                    return;
                }

                const initialRows = parseInfoRows(infoRaw.value);
                if (initialRows.length === 0) {
                    infoList.appendChild(buildInfoRow({}));
                } else {
                    initialRows.forEach((item) => infoList.appendChild(buildInfoRow(item)));
                }

                addInfoButton.addEventListener("click", () => {
                    infoList.appendChild(buildInfoRow({}));
                    serializeInfoRows();
                });

                infoRaw.form?.addEventListener("submit", serializeInfoRows);
                serializeInfoRows();
            };

            const parseFindingRows = (raw) => {
                if (!raw || !raw.trim()) {
                    return [];
                }

                return raw
                    .split(/\r?\n/)
                    .map((line) => line.trim())
                    .filter(Boolean)
                    .map((line) => {
                        const parts = line.split("|").map((part) => part.trim());
                        return {
                            icon: parts[0] || "",
                            title: parts[1] || "",
                            description: parts.slice(2).join(" | ") || ""
                        };
                    });
            };

            const serializeFindingRows = () => {
                if (!findingsRaw || !findingsList) {
                    return;
                }

                const rows = Array.from(findingsList.querySelectorAll("[data-finding-row]"))
                    .map((row) => {
                        const icon = row.querySelector("[data-finding-field='icon']")?.value?.trim() || "";
                        const title = row.querySelector("[data-finding-field='title']")?.value?.trim() || "";
                        const description = row.querySelector("[data-finding-field='description']")?.value?.trim() || "";
                        if (!icon && !title && !description) {
                            return null;
                        }

                        return `${icon} | ${title} | ${description}`;
                    })
                    .filter(Boolean);

                findingsRaw.value = rows.join("\n");
            };

            const buildFindingRow = (item = {}) => {
                const row = document.createElement("div");
                row.className = "publication-finding-row";
                row.setAttribute("data-finding-row", "");
                row.innerHTML = `
                    <div class="publication-finding-row__grid">
                        <div>
                            <label class="form-label">Icon / No.</label>
                            <input type="text" class="form-control" data-finding-field="icon" value="${escapeValue(item.icon)}">
                        </div>
                        <div>
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" data-finding-field="title" value="${escapeValue(item.title)}">
                        </div>
                        <div class="publication-finding-row__description">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" rows="3" data-finding-field="description">${escapeValue(item.description)}</textarea>
                        </div>
                    </div>
                    <div class="publication-finding-row__actions">
                        <button type="button" class="btn btn-sm btn-outline-danger" data-finding-remove>Remove</button>
                    </div>
                `;

                row.querySelectorAll("input, textarea").forEach((input) => {
                    input.addEventListener("input", serializeFindingRows);
                });

                row.querySelector("[data-finding-remove]")?.addEventListener("click", () => {
                    row.remove();
                    serializeFindingRows();
                });

                return row;
            };

            const initFindingsEditor = () => {
                if (!findingsRaw || !findingsEditor || !findingsList || !addFindingsButton) {
                    return;
                }

                const initialRows = parseFindingRows(findingsRaw.value);
                if (initialRows.length === 0) {
                    findingsList.appendChild(buildFindingRow({}));
                } else {
                    initialRows.forEach((item) => findingsList.appendChild(buildFindingRow(item)));
                }

                addFindingsButton.addEventListener("click", () => {
                    findingsList.appendChild(buildFindingRow({}));
                    serializeFindingRows();
                });

                findingsRaw.form?.addEventListener("submit", serializeFindingRows);
                serializeFindingRows();
            };

            const parseSectionRows = (raw) => {
                if (!raw || !raw.trim()) {
                    return [];
                }

                return raw
                    .split(/\r?\n/)
                    .map((line) => line.trim())
                    .filter(Boolean)
                    .map((line) => {
                        const parts = line.split("|").map((part) => part.trim());
                        return {
                            id: parts[0] || "",
                            heading: parts[1] || "",
                            paragraphs: (parts[2] || "").split("~~").map((value) => value.trim()).filter(Boolean).join("\n"),
                            bulletPoints: (parts[3] || "").split("~~").map((value) => value.trim()).filter(Boolean).join("\n"),
                            tone: parts[4] || "",
                            calloutLabel: parts[5] || "",
                            calloutTitle: parts[6] || "",
                            calloutDescription: parts.slice(7).join(" | ") || ""
                        };
                    });
            };

            const serializeSectionRows = () => {
                if (!sectionsRaw || !sectionsList) {
                    return;
                }

                const joinMulti = (value) =>
                    value
                        .split(/\r?\n/)
                        .map((item) => item.trim())
                        .filter(Boolean)
                        .join(" ~~ ");

                const rows = Array.from(sectionsList.querySelectorAll("[data-section-row]"))
                    .map((row) => {
                        const id = row.querySelector("[data-section-field='id']")?.value?.trim() || "";
                        const heading = row.querySelector("[data-section-field='heading']")?.value?.trim() || "";
                        const paragraphs = joinMulti(row.querySelector("[data-section-field='paragraphs']")?.value || "");
                        const bulletPoints = joinMulti(row.querySelector("[data-section-field='bulletPoints']")?.value || "");
                        const tone = row.querySelector("[data-section-field='tone']")?.value?.trim() || "";
                        const calloutLabel = row.querySelector("[data-section-field='calloutLabel']")?.value?.trim() || "";
                        const calloutTitle = row.querySelector("[data-section-field='calloutTitle']")?.value?.trim() || "";
                        const calloutDescription = row.querySelector("[data-section-field='calloutDescription']")?.value?.trim() || "";

                        if (!id && !heading && !paragraphs && !bulletPoints && !tone && !calloutLabel && !calloutTitle && !calloutDescription) {
                            return null;
                        }

                        return [id, heading, paragraphs, bulletPoints, tone, calloutLabel, calloutTitle, calloutDescription].join(" | ");
                    })
                    .filter(Boolean);

                sectionsRaw.value = rows.join("\n");
            };

            const buildSectionRow = (item = {}) => {
                const row = document.createElement("div");
                row.className = "publication-section-row";
                row.setAttribute("data-section-row", "");
                row.innerHTML = `
                    <div class="publication-section-row__grid">
                        <div>
                            <label class="form-label">Id</label>
                            <input type="text" class="form-control" data-section-field="id" value="${escapeValue(item.id)}">
                        </div>
                        <div>
                            <label class="form-label">Heading</label>
                            <input type="text" class="form-control" data-section-field="heading" value="${escapeValue(item.heading)}">
                        </div>
                        <div class="publication-section-row__full">
                            <label class="form-label">Paragraphs</label>
                            <textarea class="form-control" rows="4" data-section-field="paragraphs">${escapeValue(item.paragraphs)}</textarea>
                            <div class="form-text">One paragraph per line.</div>
                        </div>
                        <div class="publication-section-row__full">
                            <label class="form-label">Bullet Points</label>
                            <textarea class="form-control" rows="3" data-section-field="bulletPoints">${escapeValue(item.bulletPoints)}</textarea>
                            <div class="form-text">One bullet per line.</div>
                        </div>
                        <div>
                            <label class="form-label">Callout Tone</label>
                            <input type="text" class="form-control" data-section-field="tone" value="${escapeValue(item.tone)}">
                        </div>
                        <div>
                            <label class="form-label">Callout Label</label>
                            <input type="text" class="form-control" data-section-field="calloutLabel" value="${escapeValue(item.calloutLabel)}">
                        </div>
                        <div>
                            <label class="form-label">Callout Title</label>
                            <input type="text" class="form-control" data-section-field="calloutTitle" value="${escapeValue(item.calloutTitle)}">
                        </div>
                        <div class="publication-section-row__full">
                            <label class="form-label">Callout Description</label>
                            <textarea class="form-control" rows="3" data-section-field="calloutDescription">${escapeValue(item.calloutDescription)}</textarea>
                        </div>
                    </div>
                    <div class="publication-section-row__actions">
                        <button type="button" class="btn btn-sm btn-outline-danger" data-section-remove>Remove</button>
                    </div>
                `;

                row.querySelectorAll("input, textarea").forEach((input) => {
                    input.addEventListener("input", serializeSectionRows);
                });

                row.querySelector("[data-section-remove]")?.addEventListener("click", () => {
                    row.remove();
                    serializeSectionRows();
                });

                return row;
            };

            const initSectionsEditor = () => {
                if (!sectionsRaw || !sectionsEditor || !sectionsList || !addSectionsButton) {
                    return;
                }

                const initialRows = parseSectionRows(sectionsRaw.value);
                if (initialRows.length === 0) {
                    sectionsList.appendChild(buildSectionRow({}));
                } else {
                    initialRows.forEach((item) => sectionsList.appendChild(buildSectionRow(item)));
                }

                addSectionsButton.addEventListener("click", () => {
                    sectionsList.appendChild(buildSectionRow({}));
                    serializeSectionRows();
                });

                sectionsRaw.form?.addEventListener("submit", serializeSectionRows);
                serializeSectionRows();
            };

            const parseChartRows = (raw) => {
                if (!raw || !raw.trim()) {
                    return [];
                }

                return raw
                    .split(/\r?\n/)
                    .map((line) => line.trim())
                    .filter(Boolean)
                    .map((line) => {
                        const parts = line.split("|").map((part) => part.trim());
                        const labels = (parts[4] || "").split("~~").map((value) => value.trim()).filter(Boolean).join("\n");
                        const series = (parts.slice(5).join(" | ") || "")
                            .split("||")
                            .map((item) => item.trim())
                            .filter(Boolean)
                            .map((item) => {
                                const itemParts = item.split("@@").map((part) => part.trim());
                                return `${itemParts[0] || ""} | ${itemParts[1] || "#1476ff"} | ${itemParts[2] || ""}`;
                            })
                            .join("\n");

                        return {
                            title: parts[0] || "",
                            subtitle: parts[1] || "",
                            chartType: parts[2] || "line",
                            suffix: parts[3] || "",
                            labels,
                            series
                        };
                    });
            };

            const serializeChartRows = () => {
                if (!chartsRaw || !chartsList) {
                    return;
                }

                const joinMulti = (value) =>
                    value
                        .split(/\r?\n/)
                        .map((item) => item.trim())
                        .filter(Boolean)
                        .join(" ~~ ");

                const normalizeSeries = (value) =>
                    value
                        .split(/\r?\n/)
                        .map((line) => line.trim())
                        .filter(Boolean)
                        .map((line) => {
                            const parts = line.split("|").map((part) => part.trim());
                            const label = parts[0] || "";
                            const color = parts[1] || "#1476ff";
                            const values = parts.slice(2).join(" | ") || "";
                            return `${label} @@ ${color} @@ ${values}`;
                        })
                        .join(" || ");

                const rows = Array.from(chartsList.querySelectorAll("[data-chart-row]"))
                    .map((row) => {
                        const title = row.querySelector("[data-chart-field='title']")?.value?.trim() || "";
                        const subtitle = row.querySelector("[data-chart-field='subtitle']")?.value?.trim() || "";
                        const chartType = row.querySelector("[data-chart-field='chartType']")?.value?.trim() || "line";
                        const suffix = row.querySelector("[data-chart-field='suffix']")?.value?.trim() || "";
                        const labels = joinMulti(row.querySelector("[data-chart-field='labels']")?.value || "");
                        const series = normalizeSeries(row.querySelector("[data-chart-field='series']")?.value || "");

                        if (!title && !subtitle && !labels && !series) {
                            return null;
                        }

                        return [title, subtitle, chartType, suffix, labels, series].join(" | ");
                    })
                    .filter(Boolean);

                chartsRaw.value = rows.join("\n");
            };

            const buildChartRow = (item = {}) => {
                const row = document.createElement("div");
                row.className = "publication-chart-row";
                row.setAttribute("data-chart-row", "");
                row.innerHTML = `
                    <div class="publication-chart-row__grid">
                        <div>
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" data-chart-field="title" value="${escapeValue(item.title)}">
                        </div>
                        <div>
                            <label class="form-label">Subtitle</label>
                            <input type="text" class="form-control" data-chart-field="subtitle" value="${escapeValue(item.subtitle)}">
                        </div>
                        <div>
                            <label class="form-label">Chart Type</label>
                            <select class="form-select" data-chart-field="chartType">
                                <option value="line"${item.chartType === "line" ? " selected" : ""}>Line</option>
                                <option value="bar"${item.chartType === "bar" ? " selected" : ""}>Bar</option>
                                <option value="doughnut"${item.chartType === "doughnut" ? " selected" : ""}>Doughnut</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Value Suffix</label>
                            <input type="text" class="form-control" data-chart-field="suffix" value="${escapeValue(item.suffix)}">
                        </div>
                        <div class="publication-chart-row__full">
                            <label class="form-label">Labels</label>
                            <textarea class="form-control" rows="3" data-chart-field="labels">${escapeValue(item.labels)}</textarea>
                            <div class="form-text">One label per line. Example: Q1, Q2, Q3.</div>
                        </div>
                        <div class="publication-chart-row__full">
                            <label class="form-label">Series</label>
                            <textarea class="form-control" rows="4" data-chart-field="series">${escapeValue(item.series)}</textarea>
                            <div class="form-text">One series per line: Series Label | #1476ff | 52, 58, 61, 67.</div>
                        </div>
                    </div>
                    <div class="publication-chart-row__actions">
                        <button type="button" class="btn btn-sm btn-outline-danger" data-chart-remove>Remove</button>
                    </div>
                `;

                row.querySelectorAll("input, textarea, select").forEach((input) => {
                    input.addEventListener("input", serializeChartRows);
                    input.addEventListener("change", serializeChartRows);
                });

                row.querySelector("[data-chart-remove]")?.addEventListener("click", () => {
                    row.remove();
                    serializeChartRows();
                });

                return row;
            };

            const initChartsEditor = () => {
                if (!chartsRaw || !chartsEditor || !chartsList || !addChartsButton) {
                    return;
                }

                const initialRows = parseChartRows(chartsRaw.value);
                if (initialRows.length === 0) {
                    chartsList.appendChild(buildChartRow({ chartType: "line" }));
                } else {
                    initialRows.forEach((item) => chartsList.appendChild(buildChartRow(item)));
                }

                addChartsButton.addEventListener("click", () => {
                    chartsList.appendChild(buildChartRow({ chartType: "line" }));
                    serializeChartRows();
                });

                chartsRaw.form?.addEventListener("submit", serializeChartRows);
                serializeChartRows();
            };

            const parseTableRows = (raw) => {
                if (!raw || !raw.trim()) {
                    return [];
                }

                return raw
                    .split(/\r?\n/)
                    .map((line) => line.trim())
                    .filter(Boolean)
                    .map((line) => {
                        const parts = line.split("|").map((part) => part.trim());
                        return {
                            corridor: parts[0] || "",
                            countriesCovered: parts[1] || "",
                            mainRoute: parts[2] || "",
                            volume: parts[3] || "",
                            growth: parts[4] || "",
                            status: parts.slice(5).join(" | ") || ""
                        };
                    });
            };

            const serializeTableRows = () => {
                if (!tableRaw || !tableList) {
                    return;
                }

                const rows = Array.from(tableList.querySelectorAll("[data-table-row]"))
                    .map((row) => {
                        const corridor = row.querySelector("[data-table-field='corridor']")?.value?.trim() || "";
                        const countriesCovered = row.querySelector("[data-table-field='countriesCovered']")?.value?.trim() || "";
                        const mainRoute = row.querySelector("[data-table-field='mainRoute']")?.value?.trim() || "";
                        const volume = row.querySelector("[data-table-field='volume']")?.value?.trim() || "";
                        const growth = row.querySelector("[data-table-field='growth']")?.value?.trim() || "";
                        const status = row.querySelector("[data-table-field='status']")?.value?.trim() || "";

                        if (!corridor && !countriesCovered && !mainRoute && !volume && !growth && !status) {
                            return null;
                        }

                        return `${corridor} | ${countriesCovered} | ${mainRoute} | ${volume} | ${growth} | ${status}`;
                    })
                    .filter(Boolean);

                tableRaw.value = rows.join("\n");
            };

            const buildTableRow = (item = {}) => {
                const row = document.createElement("div");
                row.className = "publication-table-row";
                row.setAttribute("data-table-row", "");
                row.innerHTML = `
                    <div class="publication-table-row__grid">
                        <div>
                            <label class="form-label">Corridor</label>
                            <input type="text" class="form-control" data-table-field="corridor" value="${escapeValue(item.corridor)}">
                        </div>
                        <div>
                            <label class="form-label">Countries Covered</label>
                            <input type="text" class="form-control" data-table-field="countriesCovered" value="${escapeValue(item.countriesCovered)}">
                        </div>
                        <div>
                            <label class="form-label">Main Route</label>
                            <input type="text" class="form-control" data-table-field="mainRoute" value="${escapeValue(item.mainRoute)}">
                        </div>
                        <div>
                            <label class="form-label">2025 Volume</label>
                            <input type="text" class="form-control" data-table-field="volume" value="${escapeValue(item.volume)}">
                        </div>
                        <div>
                            <label class="form-label">YoY Growth</label>
                            <input type="text" class="form-control" data-table-field="growth" value="${escapeValue(item.growth)}">
                        </div>
                        <div>
                            <label class="form-label">Status</label>
                            <input type="text" class="form-control" data-table-field="status" value="${escapeValue(item.status)}">
                        </div>
                    </div>
                    <div class="publication-table-row__actions">
                        <button type="button" class="btn btn-sm btn-outline-danger" data-table-remove>Remove</button>
                    </div>
                `;

                row.querySelectorAll("input").forEach((input) => {
                    input.addEventListener("input", serializeTableRows);
                });

                row.querySelector("[data-table-remove]")?.addEventListener("click", () => {
                    row.remove();
                    serializeTableRows();
                });

                return row;
            };

            const initTableEditor = () => {
                if (!tableRaw || !tableEditor || !tableList || !addTableButton) {
                    return;
                }

                const initialRows = parseTableRows(tableRaw.value);
                if (initialRows.length === 0) {
                    tableList.appendChild(buildTableRow({}));
                } else {
                    initialRows.forEach((item) => tableList.appendChild(buildTableRow(item)));
                }

                addTableButton.addEventListener("click", () => {
                    tableList.appendChild(buildTableRow({}));
                    serializeTableRows();
                });

                tableRaw.form?.addEventListener("submit", serializeTableRows);
                serializeTableRows();
            };

            const summaryRaw = document.querySelector("[data-executive-summary-raw]");
            const summarySurface = document.querySelector("[data-executive-summary-surface]");
            const summaryEditor = document.querySelector("[data-executive-summary-editor]");
            const summaryToolbar = document.querySelector("[data-executive-summary-toolbar]");

            const syncExecutiveSummary = () => {
                if (!summaryRaw || !summarySurface) {
                    return;
                }

                const editorRoot = summarySurface.querySelector(".ql-editor");
                if (editorRoot instanceof HTMLElement) {
                    summaryRaw.value = editorRoot.innerHTML.trim();
                    return;
                }

                summaryRaw.value = summarySurface.innerHTML.trim();
            };

            const initExecutiveSummaryEditor = () => {
                if (!summaryRaw || !summarySurface || !summaryEditor) {
                    return;
                }

                if (typeof Quill === "undefined") {
                    // Quill failed to load from the CDN — fall back to a plain editable
                    // surface so edits still reach the hidden field on submit instead of
                    // silently being dropped.
                    summarySurface.contentEditable = "true";
                    summarySurface.addEventListener("input", syncExecutiveSummary);
                    summaryRaw.form?.addEventListener("submit", syncExecutiveSummary);

                    const warning = document.createElement("div");
                    warning.className = "form-text text-warning";
                    warning.textContent = "Rich text toolbar failed to load. Editing in plain fallback mode — formatting buttons are unavailable.";
                    summaryEditor.insertAdjacentElement("afterend", warning);
                    return;
                }

                const quill = new Quill(summarySurface, {
                    theme: "snow",
                    modules: {
                        toolbar: summaryToolbar || undefined
                    }
                });

                quill.on("text-change", () => {
                    summaryRaw.value = quill.root.innerHTML.trim();
                });

                summaryRaw.form?.addEventListener("submit", syncExecutiveSummary);
                summaryRaw.value = quill.root.innerHTML.trim();
            };

            countryCode.addEventListener("change", syncCountryLabel);
            publishedMonth?.addEventListener("change", syncMeta);
            readingTime?.addEventListener("change", syncMeta);
            syncCountryLabel();
            syncMeta();
            initExecutiveSummaryEditor();
            initDocumentsEditor();
            initRelatedEditor();
            initInfoEditor();
            initFindingsEditor();
            initSectionsEditor();
            initChartsEditor();
            initTableEditor();
        })();
    </script>
}
