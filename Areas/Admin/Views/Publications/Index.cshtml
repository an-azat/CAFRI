@model CAFRI.Areas.Admin.ViewModels.Content.PublicationIndexViewModel

<section class="admin-listing">
    <div class="admin-page__hero">
        <div class="admin-listing__header">
            <div>
                <div class="admin-eyebrow">Content Management</div>
                <h1 class="admin-page__title">Publications</h1>
                <p class="admin-page__lead">
                    Moderate imported stories from `n8n`, refine metadata and move approved materials into the public CAFRI publications catalog.
                </p>
            </div>
            <a asp-area="Admin" asp-controller="Publications" asp-action="Create" class="admin-primary-button">Create Publication</a>
        </div>
    </div>

    <div class="admin-summary-grid">
        @foreach (var card in Model.SummaryCards)
        {
            <article class="admin-summary-card">
                <div class="admin-summary-card__label">@card.Label</div>
                <div class="admin-summary-card__value">@card.Value</div>
                <div class="admin-summary-card__caption">@card.Caption</div>
            </article>
        }
    </div>

    <section class="admin-panel admin-publications-toolbar">
        <div class="admin-panel__header">
            <div>
                <div class="admin-panel__eyebrow">Moderation Workspace</div>
                <h2 class="admin-panel__title">Imported publication flow</h2>
            </div>
            <div class="admin-publications-toolbar__chips">
                <a asp-area="Admin" asp-controller="Publications" asp-action="Index" asp-route-status="review" class="admin-chip">Review Queue <span>@Model.ReviewRequiredCount</span></a>
                <a asp-area="Admin" asp-controller="Publications" asp-action="Index" asp-route-status="draft" class="admin-chip">Imported Drafts <span>@Model.ImportedDraftCount</span></a>
                <a asp-area="Admin" asp-controller="Publications" asp-action="Index" asp-route-status="published" class="admin-chip">Published <span>@Model.SummaryCards.FirstOrDefault(x => x.Label == "Published")?.Value</span></a>
                <span class="admin-chip admin-chip--ghost">Imported Today <span>@Model.ImportedTodayCount</span></span>
            </div>
        </div>

        @if (Model.ReviewQueue.Count != 0)
        {
            <div class="admin-review-queue">
                @foreach (var item in Model.ReviewQueue)
                {
                    <article class="admin-review-card">
                        <div class="admin-review-card__meta">
                            <span class="admin-status-pill @(item.RequiresReview ? "is-review" : "is-draft")">@(item.RequiresReview ? "Needs Review" : item.WorkflowStatus)</span>
                            @if (item.ImportedAtUtc is not null)
                            {
                                <span class="admin-review-card__tag">Imported</span>
                            }
                            <span class="admin-review-card__source">@(string.IsNullOrWhiteSpace(item.SourceName) ? item.SourceDomain : item.SourceName)</span>
                        </div>
                        <h3>@item.Title</h3>
                        <p>@item.Description</p>
                        <div class="admin-review-card__details">
                            <span>@(item.CategoryAssignments.Count == 0 ? item.Topic : string.Join(", ", item.CategoryAssignments.OrderBy(x => x.DisplayOrder).Select(x => x.CategoryName)))</span>
                            <span>@(item.CountryAssignments.Count == 0 ? item.CountryLabel : string.Join(", ", item.CountryAssignments.OrderBy(x => x.DisplayOrder).Select(x => x.CountryLabel)))</span>
                            <span>@((item.SourcePublishedAtUtc ?? item.CreatedAtUtc).UtcDateTime.ToString("dd MMM yyyy"))</span>
                        </div>
                        <div class="admin-review-card__actions">
                            <a asp-area="Admin" asp-controller="Publications" asp-action="Edit" asp-route-id="@item.Id" class="admin-primary-button">Review</a>
                            <form asp-area="Admin" asp-controller="Publications" asp-action="UpdateStatus" asp-route-id="@item.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="status" value="Published" />
                                <button type="submit" class="admin-chip">Publish</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="admin-panel mt-3">
        <form method="get" class="admin-filters">
            <input type="search" name="search" value="@Model.Search" class="admin-filter-control" placeholder="Search publications..." />

            <select name="type" class="form-select admin-filter-control">
                <option value="">All Types</option>
                @foreach (var type in Model.AvailableTypes)
                {
                    <option value="@type" selected="@(type == Model.Type ? "selected" : null)">@type</option>
                }
            </select>

            <select name="country" class="form-select admin-filter-control">
                <option value="">All Countries</option>
                @foreach (var country in Model.AvailableCountries)
                {
                    <option value="@country" selected="@(country == Model.Country ? "selected" : null)">@country</option>
                }
            </select>

            <select name="topic" class="form-select admin-filter-control">
                <option value="">All Categories</option>
                @foreach (var topic in Model.AvailableTopics)
                {
                    <option value="@topic" selected="@(topic == Model.Topic ? "selected" : null)">@topic</option>
                }
            </select>

            <select name="source" class="form-select admin-filter-control">
                <option value="">All Sources</option>
                @foreach (var source in Model.AvailableSources)
                {
                    <option value="@source" selected="@(source == Model.Source ? "selected" : null)">@source</option>
                }
            </select>

            <select name="status" class="form-select admin-filter-control">
                <option value="">All Statuses</option>
                <option value="published" selected="@(Model.Status == "published" ? "selected" : null)">Published</option>
                <option value="draft" selected="@(Model.Status == "draft" ? "selected" : null)">Draft</option>
                <option value="review" selected="@(Model.Status == "review" ? "selected" : null)">Requires Review</option>
                <option value="rejected" selected="@(Model.Status == "rejected" ? "selected" : null)">Rejected</option>
                <option value="archived" selected="@(Model.Status == "archived" ? "selected" : null)">Archived</option>
            </select>

            <input type="date" name="dateFrom" value="@Model.DateFrom" class="admin-filter-control" />
            <input type="date" name="dateTo" value="@Model.DateTo" class="admin-filter-control" />

            <div class="d-flex gap-2">
                <button type="submit" class="admin-primary-button">Apply</button>
                <a asp-area="Admin" asp-controller="Publications" asp-action="Index" class="admin-chip">Reset</a>
            </div>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="admin-empty-state">
                No publications found. Try adjusting your search or filters.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-data-table align-middle">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Categories</th>
                            <th>Coverage</th>
                            <th>Source</th>
                            <th>Status</th>
                            <th>Published</th>
                            <th>Order</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.Title</div>
                                <div class="text-secondary">@item.Meta</div>
                                <div class="admin-table-flags">
                                @if (item.ImportedAtUtc is not null)
                                {
                                    <span class="admin-table-flag">Imported</span>
                                }
                                @if (item.RequiresReview)
                                {
                                    <span class="admin-table-flag admin-table-flag--warning">Requires review</span>
                                }
                                </div>
                            </td>
                            <td>@item.Type</td>
                            <td>@(item.CategoryAssignments.Count == 0 ? item.Topic : string.Join(", ", item.CategoryAssignments.OrderBy(x => x.DisplayOrder).Select(x => x.CategoryName)))</td>
                            <td>@(item.CountryAssignments.Count == 0 ? item.CountryLabel : string.Join(", ", item.CountryAssignments.OrderBy(x => x.DisplayOrder).Select(x => x.CountryLabel)))</td>
                            <td>@(string.IsNullOrWhiteSpace(item.SourceName) ? item.SourceDomain : item.SourceName)</td>
                            <td>
                                <span class="admin-status-pill @(item.WorkflowStatus == "Published" ? "is-live" : "is-draft")">
                                    @item.WorkflowStatus
                                </span>
                            </td>
                            <td>@((item.SourcePublishedAtUtc ?? item.UpdatedAtUtc).UtcDateTime.ToString("dd MMM yyyy"))</td>
                            <td>@item.DisplayOrder</td>
                            <td class="text-end">
                                <div class="admin-table-actions">
                                    <a asp-area="Admin" asp-controller="Publications" asp-action="Edit" asp-route-id="@item.Id" class="admin-inline-link">Edit</a>
                                    <a asp-area="" asp-controller="Publications" asp-action="Details" asp-route-slug="@item.Slug" class="admin-inline-link" target="_blank" rel="noreferrer">Preview</a>
                                    <form asp-area="Admin" asp-controller="Publications" asp-action="UpdateStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="status" value="Published" />
                                        <button type="submit" class="admin-inline-link border-0 bg-transparent">Publish</button>
                                    </form>
                                    <form asp-area="Admin" asp-controller="Publications" asp-action="UpdateStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="status" value="Rejected" />
                                        <button type="submit" class="admin-inline-link border-0 bg-transparent">Reject</button>
                                    </form>
                                    <form asp-area="Admin" asp-controller="Publications" asp-action="UpdateStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="status" value="Archived" />
                                        <button type="submit" class="admin-inline-link border-0 bg-transparent">Archive</button>
                                    </form>
                                </div>
                                <form asp-area="Admin" asp-controller="Publications" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline admin-table-delete">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-2">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>
