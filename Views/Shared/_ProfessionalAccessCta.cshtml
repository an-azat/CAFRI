@model CAFRI.ViewModels.Shared.ProfessionalAccessCtaViewModel

<section class="professional-access-cta">
    <div class="professional-access-cta__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M17 9h-1V7a4 4 0 1 0-8 0v2H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2Zm-7-2a2 2 0 1 1 4 0v2h-4V7Zm7 12H7v-8h10v8Z" /></svg>
    </div>

    <div class="professional-access-cta__content">
        <h2 class="professional-access-cta__title">@Model.Title</h2>
        <p class="professional-access-cta__description">@Model.Description</p>
    </div>

    @if (Model.Benefits.Count > 0)
    {
        <div class="professional-access-cta__benefits">
            @foreach (var benefit in Model.Benefits)
            {
                <div class="professional-access-cta__benefit">
                    <span class="professional-access-cta__benefit-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M9.55 16.3 5.75 12.5l1.06-1.06 2.74 2.74 7.63-7.63 1.06 1.06-8.69 8.69Z" /></svg>
                    </span>
                    <span>@benefit</span>
                </div>
            }
        </div>
    }

    <div class="professional-access-cta__action">
        <a class="home-v2-button home-v2-button--primary" href="@Model.ButtonUrl">@Model.ButtonText</a>
    </div>
</section>
