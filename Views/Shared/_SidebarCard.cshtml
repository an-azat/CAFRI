@model CAFRI.ViewModels.Countries.CountrySidebarCardViewModel

<section class="sidebar-card">
    <h2 class="sidebar-card__title">@Model.Title</h2>
    <div class="sidebar-card__items">
        @foreach (var item in Model.Items)
        {
            <article class="sidebar-card__item">
                <h3>@item.Title</h3>
                <p>@item.Meta</p>
            </article>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.LinkUrl) && !string.IsNullOrWhiteSpace(Model.LinkLabel))
    {
        <a class="sidebar-card__link" href="@Model.LinkUrl">@Model.LinkLabel <span>&rarr;</span></a>
    }
</section>
