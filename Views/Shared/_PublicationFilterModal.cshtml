@model CAFRI.ViewModels.Publications.PublicationsPageViewModel

<div class="publications-filter-modal" data-publications-filter-modal hidden>
    <div class="publications-filter-modal__backdrop" data-publications-filter-close></div>

    <div class="publications-filter-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="publications-filter-title">
        <form method="get" class="publications-filter-modal__form">
            <div class="publications-filter-modal__header">
                <div>
                    <div class="publications-filter-modal__eyebrow">Filters</div>
                    <h2 id="publications-filter-title" class="publications-filter-modal__title">Refine Publications</h2>
                </div>

                <button class="publications-filter-modal__close" type="button" aria-label="Close filters" data-publications-filter-close>
                    <svg viewBox="0 0 24 24"><path d="M6.53 5.47 12 10.94l5.47-5.47 1.06 1.06L13.06 12l5.47 5.47-1.06 1.06L12 13.06l-5.47 5.47-1.06-1.06L10.94 12 5.47 6.53l1.06-1.06Z" /></svg>
                </button>
            </div>

            <div class="publications-filter-modal__body">
                <input type="hidden" name="query" value="@Model.Query" />
                <input type="hidden" name="tab" value="@Model.SelectedTab" />

                <div class="publications-filter-modal__grid">
                    <section class="filter-group">
                        <label class="filter-group__title" for="modal-publication-type">Type</label>
                        <select id="modal-publication-type" name="type">
                            @foreach (var option in Model.TypeOptions)
                            {
                                <option value="@(option == "All Types" ? string.Empty : option)" selected="@(option == Model.SelectedType ? "selected" : null)">@option</option>
                            }
                        </select>
                    </section>

                    <section class="filter-group">
                        <label class="filter-group__title" for="modal-publication-country">Country</label>
                        <select id="modal-publication-country" name="country">
                            @foreach (var option in Model.CountryOptions)
                            {
                                <option value="@(option == "All Countries" ? string.Empty : option)" selected="@(option == Model.SelectedCountry ? "selected" : null)">@option</option>
                            }
                        </select>
                    </section>

                    <section class="filter-group">
                        <label class="filter-group__title" for="modal-publication-topic">Topic</label>
                        <select id="modal-publication-topic" name="topic">
                            @foreach (var option in Model.TopicOptions)
                            {
                                <option value="@(option == "All Topics" ? string.Empty : option)" selected="@(option == Model.SelectedTopic ? "selected" : null)">@option</option>
                            }
                        </select>
                    </section>
                </div>
            </div>

            <div class="publications-filter-modal__footer">
                <a class="publications-filter-modal__reset" href="/publications?@(string.IsNullOrWhiteSpace(Model.Query) ? string.Empty : $"query={Uri.EscapeDataString(Model.Query)}")@(string.IsNullOrWhiteSpace(Model.Query) ? string.Empty : "&")tab=@Model.SelectedTab">Reset Filters</a>
                <div class="publications-filter-modal__actions">
                    <button class="publications-filter-modal__secondary" type="button" data-publications-filter-close>Cancel</button>
                    <button class="publications-filter-modal__primary" type="submit">Apply Filters</button>
                </div>
            </div>
        </form>
    </div>
</div>
