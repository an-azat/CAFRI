@model CAFRI.ViewModels.Intelligence.IntelligencePageViewModel

<aside class="filter-sidebar">
    <div class="filter-sidebar__heading">Filters</div>

    <section class="filter-group">
        <h2 class="filter-group__title">Countries</h2>
        <div class="filter-checkbox-list">
            @foreach (var option in Model.SidebarCountries)
            {
                <label class="filter-checkbox">
                    <input type="radio" name="sidebar-country" checked="@option.IsSelected" />
                    <span class="filter-checkbox__box"></span>
                    <a class="filter-checkbox__label" href="@Url.Action("Index", "Intelligence", new { search = Model.SearchTerm, country = option.Label == "All Countries" ? null : option.Label, category = Model.CategoryFilter == "All Categories" ? null : Model.CategoryFilter, institution = Model.InstitutionFilter == "All Institutions" ? null : Model.InstitutionFilter, dateRange = Model.DateRangeFilter == "Any time" ? null : Model.DateRangeFilter, sortBy = Model.SortBy == "Newest" ? null : Model.SortBy })">@option.Label</a>
                </label>
            }
        </div>
    </section>

    <section class="filter-group">
        <h2 class="filter-group__title">Categories</h2>
        <div class="filter-checkbox-list">
            @foreach (var option in Model.SidebarCategories)
            {
                <label class="filter-checkbox">
                    <input type="radio" name="sidebar-category" checked="@option.IsSelected" />
                    <span class="filter-checkbox__box"></span>
                    <a class="filter-checkbox__label" href="@Url.Action("Index", "Intelligence", new { search = Model.SearchTerm, country = Model.CountryFilter == "All Countries" ? null : Model.CountryFilter, category = option.Label == "All Categories" ? null : option.Label, institution = Model.InstitutionFilter == "All Institutions" ? null : Model.InstitutionFilter, dateRange = Model.DateRangeFilter == "Any time" ? null : Model.DateRangeFilter, sortBy = Model.SortBy == "Newest" ? null : Model.SortBy })">@option.Label</a>
                </label>
            }
        </div>
    </section>

    <section class="filter-group">
        <div class="filter-group__title-row">
            <h2 class="filter-group__title">Institutions</h2>
        </div>
        <label class="visually-hidden" for="sidebar-institutions">Institutions</label>
        <select id="sidebar-institutions" onchange="if (this.value) window.location.href=this.value;">
            <option value="@Url.Action("Index", "Intelligence", new { search = Model.SearchTerm, country = Model.CountryFilter == "All Countries" ? null : Model.CountryFilter, category = Model.CategoryFilter == "All Categories" ? null : Model.CategoryFilter, dateRange = Model.DateRangeFilter == "Any time" ? null : Model.DateRangeFilter, sortBy = Model.SortBy == "Newest" ? null : Model.SortBy })" selected="@(Model.InstitutionFilter == "All Institutions" ? "selected" : null)">All Institutions</option>
            @foreach (var option in Model.InstitutionSelectOptions)
            {
                if (option == "All Institutions")
                {
                    continue;
                }
                <option value="@Url.Action("Index", "Intelligence", new { search = Model.SearchTerm, country = Model.CountryFilter == "All Countries" ? null : Model.CountryFilter, category = Model.CategoryFilter == "All Categories" ? null : Model.CategoryFilter, institution = option, dateRange = Model.DateRangeFilter == "Any time" ? null : Model.DateRangeFilter, sortBy = Model.SortBy == "Newest" ? null : Model.SortBy })" selected="@(option == Model.InstitutionFilter ? "selected" : null)">@option</option>
            }
        </select>
    </section>

    <section class="filter-group">
        <h2 class="filter-group__title">Date Range</h2>
        <label class="visually-hidden" for="sidebar-date-range">Date range</label>
        <select id="sidebar-date-range" onchange="if (this.value) window.location.href=this.value;">
            @foreach (var option in Model.DateRangeOptions)
            {
                <option value="@Url.Action("Index", "Intelligence", new { search = Model.SearchTerm, country = Model.CountryFilter == "All Countries" ? null : Model.CountryFilter, category = Model.CategoryFilter == "All Categories" ? null : Model.CategoryFilter, institution = Model.InstitutionFilter == "All Institutions" ? null : Model.InstitutionFilter, dateRange = option == "Any time" ? null : option, sortBy = Model.SortBy == "Newest" ? null : Model.SortBy })" selected="@(option == Model.DateRangeFilter ? "selected" : null)">@option</option>
            }
        </select>
    </section>

    <a class="filter-sidebar__reset" href="/intelligence">
        <span class="button-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 5a7 7 0 1 1-6.65 9.48l1.43-.48A5.5 5.5 0 1 0 8.2 8.18L10.5 10.5H5V5l2.12 2.12A6.96 6.96 0 0 1 12 5Z" /></svg>
        </span>
        <span>Reset All Filters</span>
    </a>
</aside>
