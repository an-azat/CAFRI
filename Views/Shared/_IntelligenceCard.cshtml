@model CAFRI.ViewModels.Home.HomeIntelligenceCardViewModel

<article class="home-intelligence-card">
    <div class="home-intelligence-card__category">@Model.Category</div>
    <div class="home-intelligence-card__meta">@Model.CountryCode <span>&bull;</span> @Model.PublishedLabel</div>
    <h3 class="home-intelligence-card__title">
        <a href="@Model.Url">@Model.Title</a>
    </h3>
    <p class="home-intelligence-card__summary">@Model.Summary</p>
    <div class="home-intelligence-card__footer">
        <span class="home-intelligence-card__source">Source: @Model.Source</span>
        <a class="home-intelligence-card__link" href="@Model.Url" aria-label="Open intelligence item">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 5h5v5h-1.5V7.56l-6.72 6.72-1.06-1.06 6.72-6.72H14V5ZM6 7h5v1.5H7.5v8h8V13H17v5H6V7Z" />
            </svg>
        </a>
    </div>
</article>
