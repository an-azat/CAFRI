@model CAFRI.ViewModels.Intelligence.IntelligenceDetailsViewModel

<section class="article-hero">
    <div class="article-hero-content">
        <div class="article-badge-row">
            <span class="article-category-badge">@Model.Category</span>
            <span class="country-badge @(Model.CountryCode switch { "KZ" => "country-badge--kz", "UZ" => "country-badge--uz", "KG" => "country-badge--kg", "TJ" => "country-badge--tj", "TM" => "country-badge--tm", _ => "country-badge--default" })">@Model.CountryCode</span>
            <span class="article-badge-row__country">@Model.CountryName</span>
        </div>

        <h1 class="article-title">@Model.Title</h1>
        <p class="article-lead">@Model.ShortDescription</p>

        <div class="article-meta">
            <span>@Model.PublishedDate</span>
            <span>@Model.ReadingTime</span>
            <span>@Model.AnalysisType</span>
        </div>

        @{
            var canDownload = Model.AvailableDownloads.Any(x => x.IsDownloadable);
        }
        <div class="article-actions">
            <button
                type="button"
                class="is-primary"
                data-content-action="download"
                data-content-title="@Model.Title"
                data-download-trigger="true"
                disabled="@(!canDownload ? "disabled" : null)">
                <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" /></svg>
                Download Files
            </button>
            <button type="button" data-content-action="save" data-content-title="@Model.Title">
                Save
            </button>
        </div>
    </div>

    <div class="article-hero-image @Model.HeroImageClassName">
        @if (!string.IsNullOrWhiteSpace(Model.HeroImageUrl))
        {
            <img class="article-hero-image__photo" src="@Model.HeroImageUrl" alt="@Model.Title" />
        }
        <div class="article-hero-image__overlay"></div>
    </div>
</section>
