@model CAFRI.ViewModels.Intelligence.IntelligencePageViewModel

@{
    object BuildRoute(int pageNumber) => new
    {
        search = Model.SearchTerm,
        country = Model.CountryFilter == "All Countries" ? null : Model.CountryFilter,
        category = Model.CategoryFilter == "All Categories" ? null : Model.CategoryFilter,
        institution = Model.InstitutionFilter == "All Institutions" ? null : Model.InstitutionFilter,
        dateRange = Model.DateRangeFilter == "Any time" ? null : Model.DateRangeFilter,
        sortBy = Model.SortBy == "Newest" ? null : Model.SortBy,
        page = pageNumber
    };

    var startPage = Math.Max(1, Model.CurrentPage - 1);
    var endPage = Math.Min(Model.TotalPages, startPage + 2);
}

<nav class="pagination-shell" aria-label="Pagination">
    <div class="pagination pagination--desktop">
        @if (Model.CurrentPage <= 1)
        {
            <span class="pagination__item pagination__item--disabled">Previous</span>
        }
        else
        {
            <a class="pagination__item" href="@Url.Action("Index", "Intelligence", BuildRoute(Model.CurrentPage - 1))">Previous</a>
        }

        @if (startPage > 1)
        {
            <a class="pagination__item" href="@Url.Action("Index", "Intelligence", BuildRoute(1))">1</a>
            @if (startPage > 2)
            {
                <span class="pagination__item pagination__item--ellipsis">...</span>
            }
        }

        @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
        {
            if (pageNumber == Model.CurrentPage)
            {
                <span class="pagination__item pagination__item--active">@pageNumber</span>
            }
            else
            {
                <a class="pagination__item" href="@Url.Action("Index", "Intelligence", BuildRoute(pageNumber))">@pageNumber</a>
            }
        }

        @if (endPage < Model.TotalPages)
        {
            @if (endPage < Model.TotalPages - 1)
            {
                <span class="pagination__item pagination__item--ellipsis">...</span>
            }
            <a class="pagination__item" href="@Url.Action("Index", "Intelligence", BuildRoute(Model.TotalPages))">@Model.TotalPages</a>
        }

        @if (Model.CurrentPage >= Model.TotalPages)
        {
            <span class="pagination__item pagination__item--disabled">Next</span>
        }
        else
        {
            <a class="pagination__item" href="@Url.Action("Index", "Intelligence", BuildRoute(Model.CurrentPage + 1))">Next</a>
        }
    </div>

    <div class="pagination pagination--mobile">
        @if (Model.CurrentPage <= 1)
        {
            <span class="pagination__item pagination__item--disabled">&#8249;</span>
        }
        else
        {
            <a class="pagination__item" href="@Url.Action("Index", "Intelligence", BuildRoute(Model.CurrentPage - 1))">&#8249;</a>
        }
        <span class="pagination__compact">@Model.CurrentPage / @Model.TotalPages</span>
        @if (Model.CurrentPage >= Model.TotalPages)
        {
            <span class="pagination__item pagination__item--disabled">&#8250;</span>
        }
        else
        {
            <a class="pagination__item" href="@Url.Action("Index", "Intelligence", BuildRoute(Model.CurrentPage + 1))">&#8250;</a>
        }
    </div>
</nav>
