@model CAFRI.ViewModels.Publications.PublicationDetailsViewModel

<section class="publication-hero">
    <div class="publication-hero-content">
        <div class="publication-badges">
            <span class="publication-badge">@Model.PublicationType</span>
            <span class="publication-badge publication-badge--topic">@Model.Topic</span>
            <span class="publication-badge publication-badge--coverage">@Model.CoverageLabel</span>
        </div>

        <h1 class="publication-hero__title">@Model.Title</h1>
        <p class="publication-hero__lead">@Model.ShortDescription</p>

        <div class="publication-meta publication-meta--hero">
            <span>@Model.PublishedDate</span>
            <span>@Model.ReadingTime</span>
            <span>@Model.AuthorLabel</span>
            <span>@Model.DocumentLabel</span>
        </div>

        <div class="publication-actions">
            @for (var index = 0; index < Model.Actions.Count; index++)
            {
                var action = Model.Actions[index];
                var normalizedLabel = action.Label.Trim().ToLowerInvariant();
                var actionType = normalizedLabel.Contains("download") ? "download"
                    : normalizedLabel.Contains("share") ? "share"
                    : normalizedLabel.Contains("print") ? "print"
                    : normalizedLabel.Contains("save") ? "save"
                    : normalizedLabel.Contains("cite") ? "cite"
                    : "default";
                var canDownload = Model.Documents.Any(x => x.IsDownloadable);
                <button
                    class="@(index == 0 ? "is-primary" : index == 1 ? "is-secondary" : null)"
                    type="button"
                    data-content-action="@actionType"
                    data-content-title="@Model.Title"
                    data-download-trigger="@(actionType == "download" ? "true" : "false")"
                    disabled="@(actionType == "download" && !canDownload ? "disabled" : null)">
                    @action.Label
                </button>
            }
        </div>
    </div>
</section>
