@model CAFRI.ViewModels.Home.HomeFeaturedPublicationViewModel

<section class="home-featured-publication">
    <div class="home-featured-publication__content">
        <div class="eyebrow">@Model.Eyebrow</div>
        <h2 class="home-featured-publication__title">@Model.Title</h2>
        <p class="home-featured-publication__subtitle">@Model.Subtitle</p>
        <p class="home-featured-publication__description">@Model.Description</p>
        <div class="home-featured-publication__actions">
            <a class="btn btn-primary btn-lg" href="@Model.ReadOnlineUrl">
                <span class="button-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 4h7l4 4v12H7V4Zm1.5 1.5v13h8V8.62L13.38 5.5H8.5Zm2 5h5v1.5h-5V10.5Zm0 3h5v1.5h-5V13.5Z" />
                    </svg>
                </span>
                <span>Read Online</span>
            </a>
            <a class="btn btn-outline-light btn-lg home-outline-button" href="@Model.DownloadUrl">
                <span class="button-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M11.25 4h1.5v8.44l2.72-2.72 1.06 1.06L12 15.31 7.47 10.78l1.06-1.06 2.72 2.72V4ZM6 18h12v1.5H6V18Z" />
                    </svg>
                </span>
                <span>Download PDF</span>
            </a>
        </div>
    </div>
    <div class="home-featured-publication__visual" aria-hidden="true"></div>
    <div class="home-featured-publication__meta">
        @foreach (var item in Model.MetaItems)
        {
            <div class="home-featured-publication__meta-item">
                <span class="home-featured-publication__meta-icon">
                    @switch (item.Icon)
                    {
                        case "document":
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h7l4 4v12H7V4Zm1.5 1.5v13h8V8.62L13.38 5.5H8.5Z" /></svg>
                            break;
                        case "calendar":
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.75 3h1.5v2H14.75V3h1.5v2H19v14H5V5h2.75V3ZM6.5 9.5v8h11v-8h-11Z" /></svg>
                            break;
                        case "clock":
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4a8 8 0 1 1 0 16 8 8 0 0 1 0-16Zm.75 3h-1.5v5.25l4.5 2.7.75-1.24-3.75-2.21V7Z" /></svg>
                            break;
                        default:
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 11.5c3.4 0 6.5 1.72 6.5 3.5H5.5c0-1.78 3.1-3.5 6.5-3.5Z" /></svg>
                            break;
                    }
                </span>
                <span>@item.Label</span>
            </div>
        }
    </div>
</section>
