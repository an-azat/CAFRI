@model CAFRI.ViewModels.Publications.PublicationDetailsViewModel

<aside class="publication-sidebar">
    @if (!string.IsNullOrWhiteSpace(Model.SourceName))
    {
        <section class="publication-sidebar-card">
            <h2>Original Source</h2>
            <p class="publication-sidebar-card__source-name">@Model.SourceName</p>
            @if (!string.IsNullOrWhiteSpace(Model.SourceUrl) && Model.SourceUrl != "#")
            {
                <a class="publication-sidebar-card__link" href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer">Open original source <span>&rarr;</span></a>
            }
        </section>
    }

    @if (Model.CountryLabels.Count > 0)
    {
        <section class="publication-sidebar-card">
            <h2>Countries</h2>
            <div class="publication-sidebar-tags">
                @foreach (var country in Model.CountryLabels)
                {
                    <span class="publication-sidebar-tag">@country</span>
                }
            </div>
        </section>
    }

    @if (Model.TopicLabels.Count > 0)
    {
        <section class="publication-sidebar-card">
            <h2>Topics</h2>
            <div class="publication-sidebar-tags">
                @foreach (var topic in Model.TopicLabels)
                {
                    <span class="publication-sidebar-tag">@topic</span>
                }
            </div>
        </section>
    }

    @if (Model.PublicationInfo.Count > 0)
    {
        <section class="publication-sidebar-card">
            <h2>Publication Info</h2>
            <dl class="publication-info-list">
                @foreach (var item in Model.PublicationInfo)
                {
                    <dt>@item.Label</dt>
                    <dd>@item.Value</dd>
                }
            </dl>
        </section>
    }
</aside>
