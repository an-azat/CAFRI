@model CAFRI.ViewModels.Publications.PublicationDetailsViewModel

<aside class="publication-sidebar">
    <section class="publication-sidebar-card">
        <h2>Table of Contents</h2>
        <nav class="publication-toc">
            @foreach (var item in Model.TableOfContents)
            {
                <a class="publication-toc__link" href="#@item.TargetId" data-section-link data-target="@item.TargetId">@item.Label</a>
            }
        </nav>
    </section>

    <section class="publication-sidebar-card">
        <h2>Key Corridors</h2>
        <div class="publication-sidebar-list">
            @foreach (var item in Model.KeyTopics)
            {
                <a class="publication-sidebar-list__item" href="#@item.TargetId">
                    <strong>@item.Label</strong>
                </a>
            }
        </div>
    </section>

    <section class="publication-sidebar-card">
        <h2>Related Documents</h2>
        <div class="publication-sidebar-list">
            @foreach (var item in Model.SidebarDocuments)
            {
                <article class="publication-sidebar-list__item">
                    <strong>@item.Title</strong>
                    <span>@item.Meta</span>
                </article>
            }
        </div>
        <a class="publication-sidebar-card__link" href="#related-documents">View all documents (12) <span>&rarr;</span></a>
    </section>

    <section class="publication-sidebar-card">
        <h2>Related Intelligence</h2>
        <div class="publication-sidebar-list">
            @foreach (var item in Model.RelatedIntelligence)
            {
                <a class="publication-sidebar-list__item" href="@item.Url">
                    <strong>@item.Title</strong>
                    <span>@item.Meta</span>
                </a>
            }
        </div>
        <a class="publication-sidebar-card__link" href="/intelligence">View all related intelligence <span>&rarr;</span></a>
    </section>

    <section class="publication-sidebar-card">
        <h2>Publication Info</h2>
        <dl class="publication-info-list">
            @foreach (var item in Model.PublicationInfo)
            {
                <dt>@item.Label</dt>
                <dd>@item.Value</dd>
            }
        </dl>
    </section>
</aside>
