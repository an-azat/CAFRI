@model CAFRI.ViewModels.Countries.CountryProfilePageViewModel

<section class="country-profile-hero">
    <div class="country-profile-info">
        <div class="country-code-badge @Model.Country.AccentClass">@Model.Country.Code</div>
        <h1 class="page-title">@Model.Country.Name</h1>
        <div class="country-profile-subtitle">Country Profile</div>
        <p class="page-lead">@Model.HeroDescription</p>

        <div class="country-profile-indicators">
            @foreach (var item in Model.HeroIndicators)
            {
                <div class="country-profile-indicator">
                    <span class="country-profile-indicator__icon" aria-hidden="true">
                        @switch (item.Icon)
                        {
                            case "capital":
                                <svg viewBox="0 0 24 24"><path d="M12 4 4 8v1.5h16V8L12 4Zm-6 7h1.5v5H6v-5Zm5.25 0h1.5v5h-1.5v-5Zm5.25 0H18v5h-1.5v-5ZM4 18h16v1.5H4V18Z" /></svg>
                                break;
                            case "population":
                                <svg viewBox="0 0 24 24"><path d="M12 5a3.75 3.75 0 1 1 0 7.5A3.75 3.75 0 0 1 12 5Zm-6 12.5c0-2.07 3.03-3.75 6-3.75s6 1.68 6 3.75V19H6v-1.5Z" /></svg>
                                break;
                            case "currency":
                                <svg viewBox="0 0 24 24"><path d="M12 4.5c2.46 0 4.5 1.46 4.5 3.25S14.46 11 12 11 7.5 9.54 7.5 7.75 9.54 4.5 12 4.5Zm0 8c3.04 0 5.5 1.9 5.5 4.25S15.04 21 12 21s-5.5-1.9-5.5-4.25S8.96 12.5 12 12.5Zm0 1.5c-2.23 0-4 1.24-4 2.75s1.77 2.75 4 2.75 4-1.24 4-2.75S14.23 14 12 14Z" /></svg>
                                break;
                            default:
                                <svg viewBox="0 0 24 24"><path d="M5 18h14v1.5H5V18Zm1-2.25H7.5V10H6v5.75Zm5.25 0h1.5V6.5h-1.5v9.25Zm5.25 0H18v-7h-1.5v7Z" /></svg>
                                break;
                        }
                    </span>
                    <div>
                        <div class="country-profile-indicator__label">@item.Label</div>
                        <div class="country-profile-indicator__value">@item.Value</div>
                    </div>
                </div>
            }
        </div>
    </div>

    @{
        var heroGallery = Model.HeroGallery;
        var featuredImage = heroGallery.FirstOrDefault();
    }

    <div class="country-hero-image @Model.Country.HeroClassName">
        @if (featuredImage is not null)
        {
            <img class="country-hero-image__photo" src="@featuredImage.ImageUrl" alt="@(string.IsNullOrWhiteSpace(featuredImage.Alt) ? Model.Country.Name : featuredImage.Alt)" data-country-hero-main />
            <div class="country-hero-image__overlay country-hero-image__overlay--gallery">
                <div class="country-hero-image__gallery-copy">
                    <strong data-country-hero-title>@(string.IsNullOrWhiteSpace(featuredImage.Title) ? $"{Model.Country.Name} gallery" : featuredImage.Title)</strong>
                    <p data-country-hero-caption>@featuredImage.Caption</p>
                </div>

                @if (heroGallery.Count > 1)
                {
                    <div class="country-hero-image__thumbs">
                        @foreach (var image in heroGallery)
                        {
                            <button
                                class="country-hero-image__thumb"
                                type="button"
                                data-country-hero-thumb
                                data-image-url="@image.ImageUrl"
                                data-image-alt="@(string.IsNullOrWhiteSpace(image.Alt) ? Model.Country.Name : image.Alt)"
                                data-image-title="@(string.IsNullOrWhiteSpace(image.Title) ? $"{Model.Country.Name} gallery" : image.Title)"
                                data-image-caption="@image.Caption">
                                <img src="@image.ImageUrl" alt="@(string.IsNullOrWhiteSpace(image.Alt) ? Model.Country.Name : image.Alt)" />
                            </button>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="country-hero-image__overlay"></div>
        }
    </div>

    <aside class="country-risk-panel">
        <div class="country-risk-card">
            <div class="country-risk-card__label">Country Risk Rating</div>
            <div class="country-risk-card__badge">@Model.RiskRating</div>
            <div class="country-risk-card__meta">@Model.RiskOutlook</div>
        </div>

        <div class="country-risk-card">
            <div class="country-risk-card__label">Doing Business 2024</div>
            <div class="country-risk-card__value">@Model.DoingBusinessRank</div>
            <div class="country-risk-card__meta">@Model.DoingBusinessSource</div>
        </div>

        <div class="country-key-indicators">
            <h2 class="country-key-indicators__title">Key Indicators (2025)</h2>
            @foreach (var item in Model.KeyIndicators)
            {
                <div class="country-key-indicators__row">
                    <span>@item.Label</span>
                    <strong>@item.Value</strong>
                </div>
            }
        </div>
    </aside>
</section>
