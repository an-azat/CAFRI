@model CAFRI.ViewModels.Countries.CountryProfilePageViewModel

@* Compact country identity header: the first gallery photo sits behind a dark overlay; without a
   photo the country's card background class is used instead. *@
<section class="cp-hero @(string.IsNullOrWhiteSpace(Model.HeroBackgroundUrl) ? Model.Country.HeroClassName : null)">
    @if (!string.IsNullOrWhiteSpace(Model.HeroBackgroundUrl))
    {
        <img class="cp-hero__photo" src="@Model.HeroBackgroundUrl" alt="" aria-hidden="true" fetchpriority="high" />
    }
    <div class="cp-hero__content">
        <div class="cp-hero__topline">
            <span>Country intelligence profile</span>
            @if (!string.IsNullOrWhiteSpace(Model.UpdatedLabel))
            {
                <span class="cp-hero__updated">Updated · @Model.UpdatedLabel</span>
            }
        </div>

        <div class="cp-hero__identity">
            @if (!string.IsNullOrWhiteSpace(Model.FlagImageUrl))
            {
                <img class="cp-hero__flag" src="@Model.FlagImageUrl" alt="Flag of @Model.Title" />
            }
            <div>
                @if (!string.IsNullOrWhiteSpace(Model.Region))
                {
                    <div class="cp-hero__region">@Model.Region</div>
                }
                <h1 class="cp-hero__title">@Model.Title</h1>
                <p class="cp-hero__lead">@Model.HeroDescription</p>
            </div>
        </div>

        @if (Model.HeroFacts.Count > 0)
        {
            <dl class="cp-hero__facts">
                @foreach (var fact in Model.HeroFacts)
                {
                    <div class="cp-hero__fact">
                        <dt>@fact.Label</dt>
                        <dd>
                            <strong>@fact.Value</strong>
                            @if (!string.IsNullOrWhiteSpace(fact.Note))
                            {
                                <small>@fact.Note</small>
                            }
                        </dd>
                    </div>
                }
            </dl>
        }

        @if (!string.IsNullOrWhiteSpace(Model.DataSource))
        {
            <div class="cp-hero__source">Source: @Model.DataSource</div>
        }
    </div>
</section>
