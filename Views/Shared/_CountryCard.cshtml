@model CAFRI.ViewModels.Countries.CountryOverviewCardViewModel

<article class="country-card">
    <a class="country-card__image @Model.HeroClassName" href="@Model.Url" aria-label="Open @Model.Name profile">
        <span class="country-card__image-overlay"></span>
    </a>

    <div class="country-card__body">
        <div class="country-card__header">
            <span class="country-badge @Model.AccentClass">@Model.Code</span>
            <h2 class="country-card__title"><a href="@Model.Url">@Model.Name</a></h2>
        </div>

        <div class="country-card__capital">Capital: @Model.Capital</div>
        <p class="country-card__summary">@Model.Summary</p>

        <div class="country-metrics">
            @foreach (var metric in Model.Metrics)
            {
                <div class="country-metrics__item">
                    <span class="country-metrics__icon" aria-hidden="true">
                        @switch (metric.Icon)
                        {
                            case "people":
                                <svg viewBox="0 0 24 24"><path d="M12 5a3.75 3.75 0 1 1 0 7.5A3.75 3.75 0 0 1 12 5Zm-6 12.5c0-2.07 3.03-3.75 6-3.75s6 1.68 6 3.75V19H6v-1.5Z" /></svg>
                                break;
                            case "bank":
                                <svg viewBox="0 0 24 24"><path d="M12 4 4 8v1.5h16V8L12 4Zm-6 7h1.5v5H6v-5Zm5.25 0h1.5v5h-1.5v-5Zm5.25 0H18v5h-1.5v-5ZM4 18h16v1.5H4V18Z" /></svg>
                                break;
                            default:
                                <svg viewBox="0 0 24 24"><path d="M5 18h14v1.5H5V18Zm1-2.25H7.5V10H6v5.75Zm5.25 0h1.5V6.5h-1.5v9.25Zm5.25 0H18v-7h-1.5v7Z" /></svg>
                                break;
                        }
                    </span>
                    <div>
                        <div class="country-metrics__label">@metric.Label</div>
                        <div class="country-metrics__value">@metric.Value</div>
                    </div>
                </div>
            }
        </div>

        <a class="country-card__link" href="@Model.Url">View Profile <span>&rarr;</span></a>
    </div>
</article>
