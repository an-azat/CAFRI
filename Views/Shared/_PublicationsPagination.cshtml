@model CAFRI.ViewModels.Publications.PublicationsPageViewModel
@{
    var query = Context.Request.Query["query"].ToString();
    var type = Context.Request.Query["type"].ToString();
    var country = Context.Request.Query["country"].ToString();
    var topic = Context.Request.Query["topic"].ToString();
    var tab = string.IsNullOrWhiteSpace(Context.Request.Query["tab"].ToString()) ? Model.SelectedTab : Context.Request.Query["tab"].ToString();

    string BuildPageUrl(int pageNumber)
    {
        var values = new List<string> { $"page={pageNumber}" };
        if (!string.IsNullOrWhiteSpace(tab)) values.Add($"tab={Uri.EscapeDataString(tab)}");
        if (!string.IsNullOrWhiteSpace(query)) values.Add($"query={Uri.EscapeDataString(query)}");
        if (!string.IsNullOrWhiteSpace(type) && !string.Equals(type, "All Types", StringComparison.OrdinalIgnoreCase)) values.Add($"type={Uri.EscapeDataString(type)}");
        if (!string.IsNullOrWhiteSpace(country) && !string.Equals(country, "All Countries", StringComparison.OrdinalIgnoreCase)) values.Add($"country={Uri.EscapeDataString(country)}");
        if (!string.IsNullOrWhiteSpace(topic) && !string.Equals(topic, "All Topics", StringComparison.OrdinalIgnoreCase)) values.Add($"topic={Uri.EscapeDataString(topic)}");
        return "/publications?" + string.Join("&", values);
    }
}

@if (Model.TotalPages > 1)
{
    <nav class="publications-pagination" aria-label="Publications pagination">
        <div class="pagination pagination--desktop">
            @if (Model.CurrentPage > 1)
            {
                <a class="pagination__item" href="@BuildPageUrl(Model.CurrentPage - 1)">&#8249;</a>
            }
            else
            {
                <span class="pagination__item">&#8249;</span>
            }

            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                if (pageNumber == Model.CurrentPage)
                {
                    <span class="pagination__item pagination__item--active">@pageNumber</span>
                }
                else
                {
                    <a class="pagination__item" href="@BuildPageUrl(pageNumber)">@pageNumber</a>
                }
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a class="pagination__item" href="@BuildPageUrl(Model.CurrentPage + 1)">&#8250;</a>
            }
            else
            {
                <span class="pagination__item">&#8250;</span>
            }
        </div>
        <div class="pagination pagination--mobile">
            @if (Model.CurrentPage > 1)
            {
                <a class="pagination__item" href="@BuildPageUrl(Model.CurrentPage - 1)">&#8249;</a>
            }
            else
            {
                <span class="pagination__item">&#8249;</span>
            }
            <span class="pagination__compact">@Model.CurrentPage / @Model.TotalPages</span>
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a class="pagination__item" href="@BuildPageUrl(Model.CurrentPage + 1)">&#8250;</a>
            }
            else
            {
                <span class="pagination__item">&#8250;</span>
            }
        </div>
    </nav>
}
