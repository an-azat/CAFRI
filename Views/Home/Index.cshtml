@model HomePageViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["PageTheme"] = "theme-home";

    var countryRows = Model.Countries.Take(5).ToList();
    var latestCards = Model.LatestIntelligence.Take(3).ToList();

    string countryFlagIcon(string code) => code switch
    {
        "KZ" => "/uploads/img/icons8-казахстан-48.png",
        "UZ" => "/uploads/img/icons8-узбекистан-48.png",
        "KG" => "/uploads/img/icons8-киргизия-48.png",
        "TJ" => "/uploads/img/icons8-таджикистан-48.png",
        "TM" => "/uploads/img/icons8-туркменистан-циркуляр-48.png",
        _ => string.Empty
    };
}

<div class="home-v2">
    <section class="home-v2-hero">
        <div class="home-v2-hero__media" aria-hidden="true"></div>
        <div class="home-v2-hero__fade" aria-hidden="true"></div>

        <div class="site-container">
            <div class="home-v2-hero__content">
               
                <h1 class="home-v2-hero__title">@Model.HeroTitle</h1>
                <p class="home-v2-hero__lead">@Model.HeroLead</p>

                <div class="home-v2-hero__actions">
                    <a class="home-v2-button home-v2-button--primary" href="@Model.HeroPrimaryCtaUrl">@Model.HeroPrimaryCtaLabel</a>
                    <a class="home-v2-button home-v2-button--ghost" href="@Model.HeroSecondaryCtaUrl">@Model.HeroSecondaryCtaLabel</a>
                </div>

               
            </div>
        </div>
    </section>

    <section class="home-v2-intro">
        <div class="home-v2-intro__card">
            <h2>@Model.IntroTitle</h2>
            <p>@Model.IntroDescription</p>
        </div>
    </section>

    <section class="home-v2-section">
        <div class="home-v2-section__head">
            <span class="home-v2-section__label">@Model.PlatformSectionLabel</span>
            <h2>@Model.PlatformSectionTitle</h2>
            <p>@Model.PlatformSectionDescription</p>
        </div>

        <div class="home-v2-directions">
            @foreach (var item in Model.Directions)
            {
                <a class="home-v2-direction-card @(item.IsWide ? "home-v2-direction-card--wide" : null)" href="@item.Url">
                    <div>
                        <span class="home-v2-direction-card__number">@item.Number</span>
                        <h3>@item.Title</h3>
                        <p>@item.Description</p>
                    </div>
                    <span class="home-v2-direction-card__link">@item.LinkLabel</span>
                </a>
            }
        </div>
    </section>

    <section class="home-v2-countries">
        <div class="home-v2-countries__layout">
            <div>
                <div class="home-v2-section__head">
                    <span class="home-v2-section__label">@Model.CountriesSectionLabel</span>
                    <h2>@Model.CountriesSectionTitle</h2>
                    <p>@Model.CountriesSectionDescription</p>
                </div>

                <div class="home-v2-country-list">
                    @foreach (var country in countryRows)
                    {
                        <a class="home-v2-country-row" href="@country.Url">
                            <span class="home-v2-country-row__code @country.AccentClass">
                                <img class="home-v2-country-row__flag-icon" src="@countryFlagIcon(country.Code)" alt="@country.Name flag" />
                            </span>
                            <div>
                                <h3>@country.Name</h3>
                                <p>@country.Summary</p>
                            </div>
                            <span class="home-v2-country-row__arrow">&rarr;</span>
                        </a>
                    }
                </div>
            </div>

            <a class="home-v2-visual-panel" href="/countries">
                <div class="home-v2-visual-panel__caption">
                    <h3>@Model.CountriesVisualTitle</h3>
                    <p>@Model.CountriesVisualDescription</p>
                </div>
            </a>
        </div>
    </section>

    <section class="home-v2-section home-v2-section--features">
        <div class="home-v2-section__head">
            <span class="home-v2-section__label">@Model.FeaturesSectionLabel</span>
            <h2>@Model.FeaturesSectionTitle</h2>
            <p>@Model.FeaturesSectionDescription</p>
        </div>

        <div class="home-v2-feature-grid">
            @foreach (var item in Model.FeatureCards)
            {
                <a class="home-v2-feature-card @item.CssClassName" href="@item.Url">
                    <h3>@item.Title</h3>
                    <p>@item.Description</p>
                </a>
            }
        </div>
    </section>

    <section class="home-v2-latest">
        <div class="home-v2-section__head">
            <span class="home-v2-section__label">@Model.LatestSectionLabel</span>
            <h2>@Model.LatestSectionTitle</h2>
            <p>@Model.LatestSectionDescription</p>
        </div>

        <div class="home-v2-latest__grid">
            <article class="home-v2-article-card home-v2-article-card--main">
                <div class="home-v2-article-card__meta">
                    <span>@(string.IsNullOrWhiteSpace(Model.FeaturedPublicationEyebrow) ? Model.FeaturedPublication.Eyebrow : Model.FeaturedPublicationEyebrow)</span>
                    <span>@Model.FeaturedPublication.MetaItems.FirstOrDefault(x => x.Icon == "calendar")?.Label</span>
                </div>
                <h3>@Model.FeaturedPublication.Title</h3>
                <p>@Model.FeaturedPublication.Description</p>
                <a href="@Model.FeaturedPublication.ReadOnlineUrl">@Model.LatestFeaturedLinkLabel</a>
            </article>

            @foreach (var item in latestCards.Skip(1))
            {
                <article class="home-v2-article-card">
                    <div class="home-v2-article-card__meta">
                        <span>@item.Category</span>
                        <span>@item.CountryCode</span>
                    </div>
                    <h3>@item.Title</h3>
                    <p>@item.Summary</p>
                    <a href="@item.Url">@Model.LatestIntelligenceLinkLabel</a>
                </article>
            }
        </div>
    </section>

    <section class="home-v2-about">
        <div class="home-v2-about__box">
            <div>
                <h2>@Model.AboutTitle</h2>
                <p>@Model.AboutDescription</p>
            </div>

            <div class="home-v2-about__list">
                @foreach (var area in Model.CoverageAreas.Take(5))
                {
                    <div class="home-v2-about__item">@area.Title</div>
                }
            </div>
        </div>
    </section>
</div>
