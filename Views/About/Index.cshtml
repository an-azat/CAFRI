@model CAFRI.ViewModels.About.AboutPageViewModel
@{
    ViewData["Title"] = "About";
    ViewData["PageTheme"] = "theme-home";
}

<div class="page-about">
    <section class="about-hero about-hero--editorial">
        <div class="about-hero-content">
            <span class="home-v2-section__label">About the initiative</span>
            <h1 class="page-title">About CAFRI</h1>
            <p class="page-lead">@Model.Description</p>
            <p class="page-lead">@Model.DescriptionSecondary</p>
            <div class="hero-actions">
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a class="home-v2-button home-v2-button--primary" href="/access/request">Request Professional Access</a>
                }
                <a class="home-v2-button home-v2-button--ghost" href="mailto:contact@cafri.org">Contact Us</a>
            </div>
        </div>

        <div class="about-hero-media" aria-label="About CAFRI hero image">
            <img src="~/uploads/img/HeroImgAbout.png" alt="CAFRI about hero" />
        </div>
    </section>

    <section class="about-feature-row">
        @foreach (var item in Model.HeroFeatures)
        {
            <partial name="_AboutFeatureItem" model="item" />
        }
    </section>

    <section class="about-section">
        <h2>What is CAFRI?</h2>
        <p>CAFRI is an intelligence and data platform that tracks financial regulation, banking sector developments, trade and logistics, sanctions, compliance requirements, and macroeconomic indicators across Kazakhstan, Kyrgyzstan, Uzbekistan, Tajikistan, and Turkmenistan.</p>
        <p>The goal of the platform is to turn complex regulatory and economic information into clear, structured, and actionable intelligence for professionals working with Central Asia.</p>
        <p>@Model.AuthorDescription</p>
    </section>

    <section class="about-section">
        <h2>About the Founder</h2>
        <p>CAFRI was founded by Anuar Abdrakhmanov, an international relations professional specializing in Central Asia with nearly two decades of experience across public administration, diplomacy, and international cooperation within central banking. He holds graduate degrees in International Relations and Public Administration.</p>
        <p>His professional background includes positions at the Ministry of Foreign Affairs of the Kyrgyz Republic, the Presidential and Government Administrations, and diplomatic postings in Belgium, where his responsibilities included cooperation with European Union institutions, including the European Commission.</p>
        <p>Most recently, he served as Head of the Department of International Cooperation at the National Bank of the Kyrgyz Republic, where he coordinated institutional cooperation with the International Monetary Fund, the World Bank, foreign central banks, and other international financial institutions.</p>
        <p>Throughout his career, he worked at the intersection of international policy, financial institutions, and cross-border cooperation. Through these responsibilities, he observed how financial regulation, supervisory practice, and institutional decision-making shape financial sector developments across Central Asia and identified a persistent gap: the absence of a structured, methodology-based source of financial and regulatory analysis designed for international professional audiences.</p>
        <p>This experience continues to inform CAFRI's analytical methodology and institutional approach to financial and regulatory intelligence in Central Asia.</p>
    </section>

    <section class="about-section">
        <h2>What CAFRI Covers</h2>
        <p>CAFRI monitors and organizes information across the main areas that shape financial and economic decision-making in Central Asia.</p>
        <div class="coverage-grid">
            @foreach (var item in Model.CoverageAreas)
            {
                <partial name="_CoverageAreaCard" model="item" />
            }
        </div>
    </section>

    <section class="about-section geographic-coverage">
        <div class="about-section__grid">
            <div>
                <h2>Geographic Coverage</h2>
                <p>The platform focuses on Central Asia, with structured profiles and intelligence coverage for five countries.</p>
                <ul class="about-list">
                    @foreach (var item in Model.GeographicCountries)
                    {
                        <li>@item</li>
                    }
                </ul>
            </div>
            <div class="geographic-coverage__badges">
                @foreach (var item in Model.CountryBadges)
                {
                    <span class="country-badge @(item switch { "KZ" => "country-badge--kz", "UZ" => "country-badge--uz", "KG" => "country-badge--kg", "TJ" => "country-badge--tj", "TM" => "country-badge--tm", _ => "country-badge--default" })">@item</span>
                }
            </div>
        </div>
    </section>

    <section class="about-section">
        <h2>Our Sources</h2>
        <p>CAFRI collects and structures information from official and reliable sources.</p>
        <div class="sources-grid">
            @foreach (var item in Model.Sources)
            {
                <partial name="_SourceItem" model="item" />
            }
        </div>
    </section>

    <section class="about-section">
        <h2>How CAFRI Works</h2>
        <p>CAFRI follows a structured workflow to ensure accuracy, consistency, and relevance.</p>
        <div class="workflow">
            @foreach (var item in Model.WorkflowSteps)
            {
                <partial name="_WorkflowStep" model="item" />
            }
        </div>
    </section>

    <section class="about-section">
        <h2>Who Uses CAFRI?</h2>
        <p>CAFRI is designed for professionals and organizations that need reliable intelligence to assess risks, monitor developments, and support strategic planning in Central Asia.</p>
        <div class="audience-grid">
            @foreach (var item in Model.Audiences)
            {
                <partial name="_AudienceCard" model="item" />
            }
        </div>
    </section>

    <section class="about-section why-cafri">
        <h2>Why CAFRI Matters</h2>
        <p>Central Asia is becoming increasingly important for trade, finance, logistics, investment, and regional connectivity. At the same time, information across the region is often fragmented across multiple institutions, countries, and languages.</p>
        <p>CAFRI helps solve this problem by collecting, structuring, and presenting intelligence in a clear format that supports professional decision-making.</p>
        <ul class="about-list">
            @foreach (var item in Model.WhyItMattersPoints)
            {
                <li>@item</li>
            }
        </ul>
    </section>

    <partial name="_BottomCta" />
</div>
