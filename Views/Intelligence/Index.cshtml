@model CAFRI.ViewModels.Intelligence.IntelligencePageViewModel
@{
    ViewData["Title"] = "Intelligence";
    ViewData["PageTheme"] = "theme-home";
    var professionalAccessCta = new CAFRI.ViewModels.Shared.ProfessionalAccessCtaViewModel
    {
        Title = "Unlock Deeper Intelligence",
        Description = "Professional Access opens the full CAFRI intelligence library, advanced monitoring workflows, and premium analytical tools.",
        ButtonText = "Get Professional Access",
        ButtonUrl = "/access/request",
        Benefits = Model.ProfessionalAccessBenefits
    };
}

<div class="page-intelligence">
    <section class="intelligence-header intelligence-header--editorial">
        <div class="intelligence-header__copy">
            <span class="home-v2-section__label">Regulatory monitoring</span>
            <h1 class="intelligence-header__title">Intelligence</h1>
            <p class="intelligence-header__description">Regulatory, banking and market intelligence across Central Asia.</p>
        </div>
    </section>

    <div class="intelligence-layout">
        <section class="intelligence-content">
            <div class="intelligence-results-header intelligence-results-header--editorial">
                <div class="intelligence-results-header__count">
                    @(Model.TotalResults > 0
                        ? $"Showing {Model.ShowingFrom}-{Model.ShowingTo} of {Model.TotalResults} results"
                        : "No intelligence items found")
                </div>

                <div class="intelligence-results-header__search">
                    <partial name="_FilterBar" model="Model" />
                </div>

                <div class="intelligence-results-header__sort">
                    <label for="sort-by">Sort by:</label>
                    <select id="sort-by" onchange="if (this.value) window.location.href=this.value;">
                        <option value="@Url.Action("Index", "Intelligence", new { search = Model.SearchTerm, country = Model.CountryFilter == "All Countries" ? null : Model.CountryFilter, category = Model.CategoryFilter == "All Categories" ? null : Model.CategoryFilter, institution = Model.InstitutionFilter == "All Institutions" ? null : Model.InstitutionFilter, dateRange = Model.DateRangeFilter == "Any time" ? null : Model.DateRangeFilter, sortBy = "Newest" })" selected="@(Model.SortBy == "Newest" ? "selected" : null)">Newest</option>
                        <option value="@Url.Action("Index", "Intelligence", new { search = Model.SearchTerm, country = Model.CountryFilter == "All Countries" ? null : Model.CountryFilter, category = Model.CategoryFilter == "All Categories" ? null : Model.CategoryFilter, institution = Model.InstitutionFilter == "All Institutions" ? null : Model.InstitutionFilter, dateRange = Model.DateRangeFilter == "Any time" ? null : Model.DateRangeFilter, sortBy = "Oldest" })" selected="@(Model.SortBy == "Oldest" ? "selected" : null)">Oldest</option>
                        <option value="@Url.Action("Index", "Intelligence", new { search = Model.SearchTerm, country = Model.CountryFilter == "All Countries" ? null : Model.CountryFilter, category = Model.CategoryFilter == "All Categories" ? null : Model.CategoryFilter, institution = Model.InstitutionFilter == "All Institutions" ? null : Model.InstitutionFilter, dateRange = Model.DateRangeFilter == "Any time" ? null : Model.DateRangeFilter, sortBy = "Country" })" selected="@(Model.SortBy == "Country" ? "selected" : null)">Country</option>
                    </select>
                </div>
            </div>

            @if (Model.Items.Count > 0)
            {
                <div class="intelligence-grid">
                    @foreach (var item in Model.Items)
                    {
                        <partial name="_IntelligenceCatalogCard" model="item" />
                    }
                </div>

                <partial name="_Pagination" model="Model" />
            }
            else
            {
                <section class="intelligence-empty-state">
                    <h2>No intelligence items found</h2>
                    <p>Try adjusting your filters or search query.</p>
                    <a class="home-v2-button home-v2-button--ghost intelligence-empty-state__button" href="@Url.Action("Index", "Intelligence")">Reset Filters</a>
                </section>
            }
        </section>
    </div>

    <partial name="_IntelligenceFilterModal" model="Model" />

    @if (User.Identity?.IsAuthenticated != true)
    {
        <partial name="_ProfessionalAccessCta" model="professionalAccessCta" />
    }
</div>
