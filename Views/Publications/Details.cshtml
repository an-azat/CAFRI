@model CAFRI.ViewModels.Publications.PublicationDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["PageTheme"] = "theme-home";
    var showLockedPreview = !Model.CanAccessFullContent;
    var publicationPreviewText = Model.ExecutiveSummaryParagraphs.FirstOrDefault() ?? Model.ShortDescription;
    var loginUrl = Url.Action("Login", "Account", new { returnUrl = Context.Request.Path + Context.Request.QueryString }) ?? "/Account/Login";
    var accessGate = new CAFRI.ViewModels.Shared.ContentAccessGateViewModel
    {
        Breadcrumbs =
        [
            new() { Label = "Publications", Url = "/publications" },
            new() { Label = Model.PublicationType, Url = $"/publications?type={Uri.EscapeDataString(Model.PublicationType)}" },
            new() { Label = "Publication" }
        ],
        Kicker = $"{Model.CoverageLabel} · {Model.Topic}",
        Title = Model.Title,
        MetaItems = new[] { string.IsNullOrWhiteSpace(Model.PublishedDate) ? null : $"Published {Model.PublishedDate}", Model.ReadingTime, Model.AuthorLabel }
            .Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!).ToList(),
        Tags = new[] { Model.Topic, Model.CoverageLabel }.Concat(Model.CountryLabels)
            .Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).ToList(),
        CoverImageUrl = Model.HeroImageUrl,
        CoverLabel = $"CAFRI · {Model.PublicationType}",
        CoverTitle = Model.Title,
        Preview = publicationPreviewText,
        GateTitle = "Full publication is available after sign in",
        GateDescription = "Sign in to read the full publication.",
        SignInLabel = "Sign in to read full publication",
        SignInUrl = loginUrl,
        DetailRows = new CAFRI.ViewModels.Shared.GateDetailRowViewModel[]
            {
                new() { Label = "Coverage", Value = Model.CoverageLabel },
                new() { Label = "Content type", Value = Model.PublicationType },
                new() { Label = "Author", Value = Model.AuthorLabel },
                new() { Label = "Documents", Value = Model.Documents.Count(x => x.IsDownloadable) is var files && files > 0 ? $"{files} file{(files == 1 ? "" : "s")} after sign in" : "" },
                new() { Label = "Access", Value = "Sign-in required" }
            }
            .Where(x => !string.IsNullOrWhiteSpace(x.Value)).ToList(),
        RelatedTitle = "Related publications",
        RelatedItems = Model.RelatedPublications.Take(3)
            .Select(x => new CAFRI.ViewModels.Shared.GateRelatedItemViewModel { Meta = string.IsNullOrEmpty(x.DateLabel) ? x.Type : $"{x.Type} · {x.DateLabel}", Title = x.Title, Url = x.Url })
            .ToList()
    };
}

@if (showLockedPreview)
{
    <div class="page-access-gate">
        <partial name="_ContentAccessGate" model="accessGate" />
    </div>
}
else
{
<div class="page-publication-details">
    <nav class="publication-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/publications">Publications</a>
        <span>/</span>
        <a href="/publications">@Model.PublicationType</a>
        <span>/</span>
        <span class="is-active">@Model.Title</span>
    </nav>

        <div class="publication-layout">
            <main class="publication-main">
                <partial name="_PublicationHero" model="Model" />

                <section class="publication-summary">
                    <span class="publication-summary__label">Intelligence Summary</span>
                    @if (!string.IsNullOrWhiteSpace(Model.ExecutiveSummaryHtml))
                    {
                        <div class="article-richtext">
                            @Html.Raw(Model.ExecutiveSummaryHtml)
                        </div>
                    }
                    else
                    {
                        @foreach (var paragraph in Model.ExecutiveSummaryParagraphs)
                        {
                            <p>@paragraph</p>
                        }
                    }
                </section>

                <section class="publication-facts">
                    <div class="publication-fact">
                        <div class="publication-fact__label">Countries</div>
                        <div class="publication-fact__value">@(Model.CountryLabels.Count > 0 ? string.Join(" · ", Model.CountryLabels) : Model.CoverageLabel)</div>
                    </div>
                    <div class="publication-fact">
                        <div class="publication-fact__label">Sector</div>
                        <div class="publication-fact__value">@Model.PublicationType</div>
                    </div>
                    <div class="publication-fact">
                        <div class="publication-fact__label">Topic</div>
                        <div class="publication-fact__value">@Model.Topic</div>
                    </div>
                    <div class="publication-fact">
                        <div class="publication-fact__label">Reading Time</div>
                        <div class="publication-fact__value">@Model.ReadingTime</div>
                    </div>
                </section>

                @if (Model.ExecutiveHighlights.Count > 0)
                {
                    <ul class="publication-highlight-list">
                        @foreach (var item in Model.ExecutiveHighlights)
                        {
                            <li>@item</li>
                        }
                    </ul>
                }

                @if (Model.KeyFindings.Count > 0)
                {
                    <section class="publication-findings-inline" id="key-findings">
                        <span class="publication-findings-inline__label">Key Findings</span>
                        <div class="publication-findings-grid">
                            @foreach (var item in Model.KeyFindings)
                            {
                                <article class="publication-finding-card">
                                    <span class="publication-finding-card__icon">@item.Icon</span>
                                    <h3>@item.Title</h3>
                                    <p>@item.Description</p>
                                </article>
                            }
                        </div>
                    </section>
                }

                @foreach (var contentSection in Model.Sections)
                {
                    <section class="article-section" id="@contentSection.Id">
                        <h2>@contentSection.Heading</h2>

                        @foreach (var paragraph in contentSection.Paragraphs)
                        {
                            <p>@paragraph</p>
                        }

                        @if (contentSection.BulletPoints.Count > 0)
                        {
                            <ul class="publication-bullet-list">
                                @foreach (var item in contentSection.BulletPoints)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }

                        @if (contentSection.Callout is not null)
                        {
                            <aside class="article-callout article-callout--@contentSection.Callout.Tone">
                                <span class="article-callout__label">@contentSection.Callout.Label</span>
                                <h3>@contentSection.Callout.Title</h3>
                                <p>@contentSection.Callout.Description</p>
                            </aside>
                        }
                    </section>
                }

                @if (Model.Charts.Count > 0)
                {
                    <section class="article-section" id="data-charts">
                        <h2>Data &amp; Charts</h2>
                        <div class="chart-grid">
                            @foreach (var chart in Model.Charts)
                            {
                                <partial name="_PublicationChartCard" model="chart" />
                            }
                        </div>
                    </section>
                }

                @if (Model.TableRows.Count > 0)
                {
                    <section class="article-section" id="transit-table">
                        <h2>Transit Data &amp; Performance</h2>
                        <div class="data-table-wrapper">
                            <table class="publication-data-table">
                                <thead>
                                    <tr>
                                        <th>Corridor</th>
                                        <th>Countries Covered</th>
                                        <th>Main Route</th>
                                        <th>2025 Volume</th>
                                        <th>YoY Growth</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.TableRows)
                                    {
                                        <tr>
                                            <td>@row.Corridor</td>
                                            <td>@row.CountriesCovered</td>
                                            <td>@row.MainRoute</td>
                                            <td>@row.Volume</td>
                                            <td>@row.Growth</td>
                                            <td>@row.Status</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }

                @if (Model.GalleryItems.Count > 0)
                {
                    <section class="article-section" id="photo-gallery">
                        <h2>Photo Gallery</h2>
                        <partial name="_PublicationPhotoGallery" model="Model.GalleryItems" />
                    </section>
                }

                <section class="article-section" id="related-documents">
                    <h2>Related Documents</h2>
                    <div class="document-list">
                        @foreach (var item in Model.Documents)
                        {
                            <partial name="_PublicationDocumentCard" model="item" />
                        }
                    </div>
                </section>
            </main>

            <partial name="_PublicationDetailSidebar" model="Model" />
        </div>

        <section class="related-publications" id="related-publications">
            <div class="related-publications__header">
                <h2>Related Publications</h2>
                <p>Continue exploring reports, briefs and country profiles connected to this topic.</p>
            </div>

            <div class="related-publications__grid">
                @foreach (var item in Model.RelatedPublications)
                {
                    <partial name="_RelatedPublicationCard" model="item" />
                }
            </div>
        </section>
</div>
}

@if (Model.CanAccessFullContent && Model.Documents.Any(x => x.IsDownloadable))
{
    <div class="content-download-modal" data-download-modal hidden>
        <div class="content-download-modal__backdrop" data-download-close></div>
        <div class="content-download-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="publication-download-modal-title">
            <div class="content-download-modal__header">
                <div>
                    <div class="content-download-modal__eyebrow">Available Formats</div>
                    <h2 id="publication-download-modal-title">Download Full Report</h2>
                </div>
                <button type="button" class="content-download-modal__close" data-download-close aria-label="Close">×</button>
            </div>
            <div class="content-download-modal__body">
                @foreach (var item in Model.Documents.Where(x => x.IsDownloadable))
                {
                    var optionId = $"publication-download-{item.Title.GetHashCode()}";
                    <label class="content-download-modal__option" for="@optionId">
                        <input id="@optionId" type="radio" name="publication-download-option" value="@item.DownloadUrl" @(item == Model.Documents.First(x => x.IsDownloadable) ? "checked" : null) />
                        <span class="content-download-modal__option-copy">
                            <strong>@item.Title</strong>
                            <span>@item.Type</span>
                            <small>@item.Meta</small>
                        </span>
                    </label>
                }
            </div>
            <div class="content-download-modal__footer">
                <button type="button" class="home-v2-button home-v2-button--ghost" data-download-close>Cancel</button>
                <button type="button" class="home-v2-button home-v2-button--primary" data-download-confirm>Download Selected File</button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="~/js/publication-charts.js" asp-append-version="true"></script>
    <script src="~/js/publication-gallery.js" asp-append-version="true"></script>
    <script src="~/js/publication-cards.js" asp-append-version="true"></script>
    <script src="~/js/article-actions.js" asp-append-version="true"></script>
}
