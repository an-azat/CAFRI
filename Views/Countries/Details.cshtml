@using CAFRI.ViewModels.Countries
@model CAFRI.ViewModels.Countries.CountryProfilePageViewModel
@{
    ViewData["Title"] = Model.Country.Name;
    ViewData["PageTheme"] = "theme-home";
    ViewData["Description"] = Model.HeroDescription;

    var countryQuery = Uri.EscapeDataString(Model.Country.Name);
    var latestUpdatesCard = new CountrySidebarCardViewModel
    {
        Title = "Latest Updates",
        Items = Model.LatestUpdates,
        EmptyText = $"No intelligence updates for {Model.Country.Name} yet.",
        LinkLabel = "View all updates",
        LinkUrl = $"/intelligence/archive?country={countryQuery}"
    };
    var relatedPublicationsCard = new CountrySidebarCardViewModel
    {
        Title = "Related Publications",
        Items = Model.RelatedPublications,
        EmptyText = $"No publications on {Model.Country.Name} yet.",
        LinkLabel = "View all publications",
        LinkUrl = $"/publications?country={countryQuery}"
    };
    var profile = Model.Profile;
    var hasAnalysis = !string.IsNullOrWhiteSpace(profile.AnalysisLead) || profile.AnalysisPoints.Count > 0;
    var hasMonitoring = profile.Priorities.Count > 0;
}

<div class="page-country-profile">
    <nav class="country-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/countries">Countries</a>
        <span>/</span>
        <span class="is-active">@Model.Country.Name</span>
    </nav>

    <partial name="_CountryProfileHero" model="Model" />

    <section class="cp-section">
        <div class="cp-section__head">
            <h2>About the country</h2>
            <p>Geography, people and economic structure</p>
        </div>
        <div class="cp-about @(Model.AboutFacts.Count == 0 ? "cp-about--text-only" : null)">
            <div class="cp-about__text">
                @foreach (var paragraph in Model.AboutParagraphs)
                {
                    <p>@paragraph</p>
                }
            </div>
            @if (Model.AboutFacts.Count > 0)
            {
                <dl class="cp-about__facts">
                    @foreach (var fact in Model.AboutFacts)
                    {
                        <div>
                            <dt>@fact.Label</dt>
                            <dd>@fact.Value</dd>
                        </div>
                    }
                </dl>
            }
        </div>
    </section>

    @if (Model.HeroGallery.Count > 0)
    {
        <section class="cp-section cp-card cp-gallery" data-cp-gallery>
            <h2 class="cp-card__title">Country gallery</h2>
            <div class="cp-card__sub">Landscapes and places across @Model.Title</div>
            @if (Model.HeroGallery.Count > 1)
            {
                <div class="cp-gallery__controls">
                    <span class="cp-gallery__hint">Scroll horizontally to explore</span>
                    <div class="cp-gallery__arrows">
                        <button type="button" data-cp-gallery-prev aria-label="Previous photos">&lsaquo;</button>
                        <button type="button" data-cp-gallery-next aria-label="Next photos">&rsaquo;</button>
                    </div>
                </div>
            }
            <div class="cp-gallery__track" data-cp-gallery-track tabindex="0" aria-label="@Model.Country.Name photo gallery">
                @foreach (var image in Model.HeroGallery)
                {
                    var caption = string.Join(" · ", new[] { image.Title, image.Caption }.Where(x => !string.IsNullOrWhiteSpace(x)));
                    <figure class="cp-gallery__item">
                        <img src="@image.ImageUrl" alt="@(string.IsNullOrWhiteSpace(image.Alt) ? caption : image.Alt)" loading="lazy" />
                        @if (caption.Length > 0)
                        {
                            <figcaption>@caption</figcaption>
                        }
                    </figure>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(profile.GalleryCredit))
            {
                <div class="cp-gallery__credit">@profile.GalleryCredit</div>
            }
        </section>
    }

    @if (Model.SnapshotKpis.Count > 0)
    {
        <section class="cp-section">
            <div class="cp-section__head cp-section__head--split">
                <div>
                    <h2>Economic snapshot</h2>
                    <p>Latest available official and institutional observations</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(profile.SnapshotCutoff))
                {
                    <span class="cp-asof">Data cut-off: @profile.SnapshotCutoff</span>
                }
            </div>
            <div class="cp-snapshot">
                @foreach (var kpi in Model.SnapshotKpis)
                {
                    <div class="cp-snapshot__card">
                        <div class="cp-snapshot__label">@kpi.Label</div>
                        <div class="cp-snapshot__value">@kpi.Value</div>
                        @if (!string.IsNullOrWhiteSpace(kpi.Change) || !string.IsNullOrWhiteSpace(kpi.Period))
                        {
                            <div class="cp-snapshot__foot">
                                @if (!string.IsNullOrWhiteSpace(kpi.Change))
                                {
                                    <span class="cp-delta cp-delta--@ToneClass(kpi.ChangeTone)">@kpi.Change</span>
                                }
                                @kpi.Period
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(kpi.Source))
                        {
                            <div class="cp-snapshot__source">@kpi.Source</div>
                        }
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.GdpHistory.Count > 0 || profile.Signals.Count > 0)
    {
        <section class="cp-section">
            <div class="cp-section__head cp-section__head--split">
                <div>
                    <h2>Macroeconomic performance</h2>
                    <p>@(string.IsNullOrWhiteSpace(profile.MacroSubtitle) ? "Growth trend and current macro signals" : profile.MacroSubtitle)</p>
                </div>
                <span class="cp-tag">Latest data</span>
            </div>
            <div class="cp-two @(Model.GdpHistory.Count == 0 || profile.Signals.Count == 0 ? "cp-two--single" : null)">
                @if (Model.GdpHistory.Count > 0)
                {
                    <article class="cp-card">
                        <h3 class="cp-card__title">Real GDP growth</h3>
                        <div class="cp-card__sub">@(string.IsNullOrWhiteSpace(profile.GdpSubtitle) ? "Annual change, %" : profile.GdpSubtitle)</div>
                        <partial name="_CountryGdpChart" model="Model.GdpHistory" />
                        @if (!string.IsNullOrWhiteSpace(profile.GdpNote) || !string.IsNullOrWhiteSpace(profile.GdpSourceUrl))
                        {
                            <p class="cp-note">
                                @profile.GdpNote
                                @if (!string.IsNullOrWhiteSpace(profile.GdpSourceUrl))
                                {
                                    <a href="@profile.GdpSourceUrl" target="_blank" rel="noopener noreferrer">Source &#8599;</a>
                                }
                            </p>
                        }
                    </article>
                }
                @if (profile.Signals.Count > 0)
                {
                    <article class="cp-card">
                        <h3 class="cp-card__title">Current macro signals</h3>
                        <div class="cp-card__sub">Interpretation of latest published observations</div>
                        <div class="cp-signals">
                            @foreach (var signal in profile.Signals)
                            {
                                <div class="cp-signal">
                                    <i class="cp-signal__dot @(signal.Tone == "positive" ? "cp-signal__dot--positive" : null)" aria-hidden="true"></i>
                                    <div>
                                        <strong>@signal.Title</strong>
                                        <span>@signal.Text</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @if (profile.FiscalRows.Count > 0 || !string.IsNullOrWhiteSpace(profile.DebtValue))
    {
        <section class="cp-section">
            <div class="cp-section__head">
                <h2>Public finances</h2>
                <p>Fiscal position and sovereign debt indicators</p>
            </div>
            <div class="cp-two @(profile.FiscalRows.Count == 0 || string.IsNullOrWhiteSpace(profile.DebtValue) ? "cp-two--single" : null)">
                @if (profile.FiscalRows.Count > 0)
                {
                    <article class="cp-card">
                        <h3 class="cp-card__title">Fiscal position</h3>
                        @if (!string.IsNullOrWhiteSpace(profile.FiscalSubtitle))
                        {
                            <div class="cp-card__sub">@profile.FiscalSubtitle</div>
                        }
                        <table class="cp-table">
                            <tbody>
                                @foreach (var row in profile.FiscalRows)
                                {
                                    <tr><td>@row.Label</td><td>@row.Period</td><td class="cp-table__value">@row.Value</td></tr>
                                }
                            </tbody>
                        </table>
                        @if (!string.IsNullOrWhiteSpace(profile.FiscalNote))
                        {
                            <p class="cp-note">@profile.FiscalNote</p>
                        }
                    </article>
                }
                @if (!string.IsNullOrWhiteSpace(profile.DebtValue))
                {
                    var debtPercent = ParsePercent(profile.DebtValue);
                    <article class="cp-card">
                        <h3 class="cp-card__title">Sovereign debt</h3>
                        <div class="cp-card__sub">Public debt as a share of GDP</div>
                        <div class="cp-debt">
                            <strong>@profile.DebtValue</strong>
                            <span>@profile.DebtPeriod</span>
                        </div>
                        @if (debtPercent is not null)
                        {
                            <div class="cp-debt__bar" role="presentation"><span style="width:@(Math.Clamp(debtPercent.Value, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(profile.DebtNote))
                        {
                            <p class="cp-note">@profile.DebtNote</p>
                        }
                    </article>
                }
            </div>
        </section>
    }

    @if (hasAnalysis || hasMonitoring)
    {
        <section class="cp-section">
            <div class="cp-section__head cp-section__head--split">
                <div>
                    <h2>Country analysis &amp; monitoring priorities</h2>
                    <p>CAFRI editorial assessment based on the latest available official data</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(profile.AnalysisUpdated))
                {
                    <span class="cp-asof">Analysis updated: @profile.AnalysisUpdated</span>
                }
            </div>
            <div class="cp-analysis @(!hasAnalysis || !hasMonitoring ? "cp-two--single" : null)">
                @if (hasAnalysis)
                {
                    <article class="cp-card">
                        <div class="cp-kicker">Country analysis</div>
                        <h3 class="cp-card__heading">@(string.IsNullOrWhiteSpace(profile.AnalysisHeading) ? "Macroeconomic assessment" : profile.AnalysisHeading)</h3>
                        @if (!string.IsNullOrWhiteSpace(profile.AnalysisLead))
                        {
                            <p class="cp-analysis__lead">@profile.AnalysisLead</p>
                        }
                        @for (var i = 0; i < profile.AnalysisPoints.Count; i++)
                        {
                            <div class="cp-analysis__point">
                                <span class="cp-analysis__index">@((i + 1).ToString("00"))</span>
                                <div>
                                    <strong>@profile.AnalysisPoints[i].Title</strong>
                                    <p>@profile.AnalysisPoints[i].Text</p>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(profile.AnalysisFootnote))
                        {
                            <div class="cp-card__foot">@profile.AnalysisFootnote</div>
                        }
                    </article>
                }
                @if (hasMonitoring)
                {
                    <aside class="cp-card">
                        <div class="cp-kicker">Monitoring priorities</div>
                        <h3 class="cp-card__heading">@(string.IsNullOrWhiteSpace(profile.MonitoringHeading) ? "Key areas to watch" : profile.MonitoringHeading)</h3>
                        @if (!string.IsNullOrWhiteSpace(profile.MonitoringIntro))
                        {
                            <p class="cp-card__sub">@profile.MonitoringIntro</p>
                        }
                        @foreach (var priority in profile.Priorities)
                        {
                            <div class="cp-priority">
                                <div>
                                    <strong>@priority.Title</strong>
                                    <span>@priority.Description</span>
                                </div>
                                <em class="cp-priority__level cp-priority__level--@priority.Level.ToLowerInvariant()">@priority.Level</em>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(profile.MonitoringFootnote))
                        {
                            <div class="cp-card__foot">@profile.MonitoringFootnote</div>
                        }
                    </aside>
                }
            </div>
        </section>
    }

    @if (profile.News.Count > 0)
    {
        <section class="cp-section" id="intelligence">
            <div class="cp-section__head">
                <h2>Latest country intelligence</h2>
                <p>Selected institutional updates relevant to @Model.Title</p>
            </div>
            <div class="cp-news">
                @foreach (var item in profile.News)
                {
                    <article class="cp-news__item">
                        @if (!string.IsNullOrWhiteSpace(item.TypeDate))
                        {
                            <div class="cp-news__type">@item.TypeDate</div>
                        }
                        <h3>@item.Headline</h3>
                        @if (!string.IsNullOrWhiteSpace(item.Summary))
                        {
                            <p>@item.Summary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Url))
                        {
                            <a href="@item.Url" target="_blank" rel="noopener noreferrer">Read source &#8599;</a>
                        }
                    </article>
                }
            </div>
        </section>
    }

    <section class="cp-section">
        <div class="cp-section__head">
            <h2>CAFRI coverage</h2>
            <p>Intelligence updates and publications on @Model.Country.Name</p>
        </div>
        <div class="cp-two">
            <partial name="_SidebarCard" model="latestUpdatesCard" />
            <partial name="_SidebarCard" model="relatedPublicationsCard" />
        </div>
    </section>

    @if (Model.DataSources.Count > 0)
    {
        <section class="cp-section">
            <div class="cp-section__head">
                <h2>Data sources</h2>
                <p>Primary sources used for this profile</p>
            </div>
            <div class="cp-sources">
                @foreach (var source in Model.DataSources)
                {
                    <div class="cp-source">
                        <strong>@source.Institution</strong>
                        @if (!string.IsNullOrWhiteSpace(source.Description))
                        {
                            <span>@source.Description</span>
                        }
                        @if (Uri.TryCreate(source.Url, UriKind.Absolute, out var sourceUri))
                        {
                            <a href="@source.Url" target="_blank" rel="noopener noreferrer">@sourceUri.Host.Replace("www.", string.Empty) &#8599;</a>
                        }
                    </div>
                }
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(profile.Methodology))
    {
        <div class="cp-disclaimer"><strong>Data methodology:</strong> @profile.Methodology</div>
    }
</div>

@section Scripts {
    <script src="~/js/country-gallery.js" asp-append-version="true"></script>
}

@functions {
    private static string ToneClass(string? tone) => tone switch
    {
        "positive" => "positive",
        "negative" => "negative",
        _ => "neutral"
    };

    // "40.5%" -> 40.5, used for the debt bar; anything else draws no bar.
    private static double? ParsePercent(string value) =>
        double.TryParse(value.Trim().TrimEnd('%').Trim(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : null;
}
