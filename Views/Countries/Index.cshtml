@using System.Text.Json
@model CAFRI.ViewModels.Countries.CountriesPageViewModel
@{
    ViewData["Title"] = "Countries";
    ViewData["PageTheme"] = "theme-home";
    var gdpGrowthYearsDesc = Model.GdpGrowthYears.OrderByDescending(y => y, StringComparer.OrdinalIgnoreCase).ToList();
    var selectedYear = Model.SelectedGdpGrowthYear;

    // Fixed capital coordinates for marker placement on the Leaflet map -
    // these are stable geographic facts, not content, so they live in code
    // rather than the CMS.
    var capitalCoords = new Dictionary<string, double[]>(StringComparer.OrdinalIgnoreCase)
    {
        ["KZ"] = new[] { 51.1801, 71.4460 },
        ["UZ"] = new[] { 41.2995, 69.2401 },
        ["KG"] = new[] { 42.8746, 74.5698 },
        ["TJ"] = new[] { 38.5598, 68.7870 },
        ["TM"] = new[] { 37.9601, 58.3261 },
    };

    var mapCountries = Model.Countries.Select(c => new
    {
        code = c.Code,
        name = c.Name,
        capital = c.Capital,
        capitalLat = capitalCoords.TryGetValue(c.Code, out var coords) ? coords[0] : (double?)null,
        capitalLng = capitalCoords.TryGetValue(c.Code, out var coords2) ? coords2[1] : (double?)null,
        gdp = c.Gdp,
        population = c.Population,
        bankAssets = c.BankAssets,
        summary = c.Summary,
        focus = c.Focus,
        heroImage = c.HeroImageUrl,
        heroClass = c.HeroClassName,
        accentClass = c.AccentClass,
        url = c.Url,
        growth = c.Indicators
            .Where(i => string.Equals(i.Name, "Real GDP Growth", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(i => i.YearLabel, i => i.Value)
    }).ToList();
    var mapCountriesJson = JsonSerializer.Serialize(mapCountries);
}

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
}

<div class="page-countries">
    <section class="countries-hero countries-hero--editorial">
        <div class="countries-hero-content">
            <span class="home-v2-section__label">Regional profiles</span>
            <h1 class="page-title">Countries</h1>
            <p class="page-lead">@Model.Description</p>
        </div>
    </section>

    <section class="countries-explorer">
        <div class="countries-map-shell">
            <div class="countries-map-toolbar">
                <div class="countries-map-toolbar__title">
                    <span class="home-v2-section__label">Indicator</span>
                    <h2>GDP Growth</h2>
                </div>
                @if (gdpGrowthYearsDesc.Count > 0)
                {
                    <label class="countries-map-year-select">
                        <span>Year</span>
                        <select data-map-year-select>
                            @foreach (var year in gdpGrowthYearsDesc)
                            {
                                <option value="@year" selected="@(string.Equals(year, selectedYear, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@year</option>
                            }
                        </select>
                    </label>
                }
            </div>

            <div class="countries-map-body">
                <div class="countries-map-frame">
                    <div class="countries-map-fallback" data-map-error hidden>
                        <h2>Interactive regional map is temporarily unavailable.</h2>
                        <p>Please use the country cards below to access country profiles.</p>
                    </div>

                    <div id="countries-leaflet-map" class="countries-map" data-interactive-map data-map-style="light" data-selected-year="@selectedYear"></div>

                    <div class="countries-map-legend">
                        <span class="countries-map-legend__title">GDP Growth (<span data-map-legend-year>@selectedYear</span>)</span>
                        <ul>
                            <li><span class="countries-map-legend__swatch countries-map-legend__swatch--high"></span>6% and above</li>
                            <li><span class="countries-map-legend__swatch countries-map-legend__swatch--good"></span>4% – 6%</li>
                            <li><span class="countries-map-legend__swatch countries-map-legend__swatch--mid"></span>2% – 4%</li>
                            <li><span class="countries-map-legend__swatch countries-map-legend__swatch--low"></span>0% – 2%</li>
                            <li><span class="countries-map-legend__swatch countries-map-legend__swatch--negative"></span>Below 0%</li>
                            <li><span class="countries-map-legend__swatch countries-map-legend__swatch--none"></span>No data</li>
                        </ul>
                    </div>
                </div>
            </div>

            <p class="countries-map-hint">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm0 5.5a.9.9 0 1 1 0-1.8.9.9 0 0 1 0 1.8ZM9.1 9.5h1.8v5.4H9.1V9.5Z"/></svg>
                Click on a country to view detailed intelligence profile and latest updates.
            </p>

            <script type="application/json" id="countries-map-data">@Html.Raw(mapCountriesJson)</script>
        </div>
    </section>

    <section class="countries-grid-section">
        <div class="countries-grid-section__header">
            <div>
                <h2 class="countries-grid-section__title">Central Asian Countries</h2>
                <p class="countries-grid-section__description">Key economic overview and latest indicators for the region.</p>
            </div>
            <div class="countries-grid-section__actions">
                <button type="button" class="countries-compare-btn">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 3.5h4.5v13H4v-13Zm7.5 4H16v9h-4.5v-9Z"/></svg>
                    Compare
                </button>
                <div class="countries-grid-nav">
                    <button type="button" class="countries-grid-nav__btn" data-countries-grid-prev aria-label="Previous countries">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4 6 10l6.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <button type="button" class="countries-grid-nav__btn" data-countries-grid-next aria-label="Next countries">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4 14 10l-6.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="countries-grid" data-countries-grid>
            @foreach (var country in Model.Countries)
            {
                <partial name="_CountryCard" model="country" />
            }
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script src="~/js/interactive-map.js" asp-append-version="true"></script>
}
