@model CAFRI.ViewModels.Account.ActivationViewModel

<section class="page-shell">
    <div class="content-card">
        <div class="eyebrow">Activation</div>
        <h1 class="page-title">Activate your CAFRI account</h1>
        <p class="page-lead">
            Set your password to complete professional access activation and enter the protected intelligence area.
        </p>

        <form asp-action="Activate" method="post" class="access-form" novalidate>
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-lg">Activate account</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
