@{
    ViewData["Title"] = "Request Received";
    ViewData["PageTheme"] = "theme-home";
}

<div class="access-shell">
    <section class="access-shell__hero">
        <div class="access-shell__copy">
            <span class="home-v2-section__label">Request Received</span>
            <h1 class="page-title">Thank you. Your request has been received.</h1>
            <p class="page-lead">
                Our team will review the request and contact you after review. This matches the current CAFRI launch
                model, where professional access is approved manually before the subscription layer is introduced.
            </p>
        </div>

        <div class="access-shell__summary">
            <article class="access-shell__summary-card">
                <span>Status</span>
                <strong>Pending review</strong>
                <p>Editorial verification is required before account activation.</p>
            </article>
        </div>
    </section>

    <section class="access-shell__layout access-shell__layout--compact">
        <div class="access-shell__panel">
            @if (!string.IsNullOrWhiteSpace(ViewBag.Email as string))
            {
                <p class="access-shell__note">
                    Confirmation target: <strong>@ViewBag.Email</strong>
                </p>
            }

            <div class="form-actions">
                <a asp-controller="Home" asp-action="Index" class="home-v2-button home-v2-button--primary">Return to CAFRI</a>
            </div>
        </div>
    </section>
</div>
