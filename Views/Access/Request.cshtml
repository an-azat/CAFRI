@model CAFRI.ViewModels.Access.AccessRequestViewModel

<section class="page-shell">
    <div class="content-card content-card-wide">
        <div class="eyebrow">Professional Access</div>
        <h1 class="page-title">Request institutional access</h1>
        <p class="page-lead">
            CAFRI grants professional access after editorial review. This initial workflow is approval-based and
            is designed for institutional users who need full regulatory and financial intelligence coverage.
        </p>

        <form asp-action="Request" method="post" class="access-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Organization" class="form-label"></label>
                    <input asp-for="Organization" class="form-control" />
                    <span asp-validation-for="Organization" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Position" class="form-label"></label>
                    <input asp-for="Position" class="form-control" />
                    <span asp-validation-for="Position" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="BusinessEmail" class="form-label"></label>
                    <input asp-for="BusinessEmail" class="form-control" />
                    <span asp-validation-for="BusinessEmail" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Country" class="form-label"></label>
                    <input asp-for="Country" class="form-control" placeholder="Kazakhstan, Kyrgyzstan, Uzbekistan, Tajikistan, Turkmenistan, or regional remit" />
                    <span asp-validation-for="Country" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="PurposeOfAccess" class="form-label"></label>
                    <textarea asp-for="PurposeOfAccess" class="form-control" rows="6" placeholder="Describe your institution, your use case, and the intelligence areas you need access to."></textarea>
                    <span asp-validation-for="PurposeOfAccess" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-lg">Submit access request</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
